{"urllib3__urllib3_a74c9cfbaed9f811e7563cfc3dce894928e0221a":"FROM base_py:3.8\n\nWORKDIR /project\n\nCOPY . .\n\n# Install Python dependencies\nRUN pip3 install -r dev-requirements.txt && \\\n    pip3 install -e \".[socks,secure,brotli]\"\n\nCMD python3 -m pytest test/test_util.py test/test_connection.py test/test_poolmanager.py test/test_response.py test/test_retry.py test/test_collections.py test/test_exceptions.py test/test_fields.py --tb=short"}
