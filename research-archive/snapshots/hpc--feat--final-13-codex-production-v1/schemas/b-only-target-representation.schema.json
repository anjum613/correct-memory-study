{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ast_structure": {
      "items": {"type": "string"},
      "type": "array"
    },
    "b_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "benchmark_instance_id": {"minLength": 1, "type": "string"},
    "benchmark_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "configuration_context": {
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]},
      "type": "object"
    },
    "language": {"minLength": 1, "type": "string"},
    "operation_categories": {
      "items": {"type": "string"},
      "type": "array"
    },
    "repository_visible_api_calls": {
      "items": {"type": "string"},
      "type": "array"
    },
    "repository_visible_imports": {
      "items": {"type": "string"},
      "type": "array"
    },
    "repository_visible_libraries": {
      "items": {"type": "string"},
      "type": "array"
    },
    "task_described_operation": {"minLength": 1, "type": "string"},
    "task_semantic_embedding": {
      "additionalProperties": false,
      "properties": {
        "model": {"minLength": 1, "type": "string"},
        "model_revision": {"minLength": 1, "type": "string"},
        "vector": {"items": {"type": "number"}, "type": "array"}
      },
      "required": ["model", "model_revision", "vector"],
      "type": ["object", "null"]
    },
    "task_statement": {"minLength": 1, "type": "string"},
    "types_and_data_roles": {
      "items": {"type": "string"},
      "type": "array"
    },
    "visible_target_symbols": {
      "items": {"type": "string"},
      "type": "array"
    }
  },
  "required": [
    "benchmark_instance_id",
    "benchmark_revision",
    "b_snapshot_sha256",
    "task_statement",
    "language",
    "repository_visible_imports",
    "repository_visible_libraries",
    "repository_visible_api_calls",
    "task_described_operation",
    "visible_target_symbols",
    "types_and_data_roles",
    "ast_structure",
    "operation_categories",
    "task_semantic_embedding",
    "configuration_context"
  ],
  "title": "SusVibes B-only target representation",
  "type": "object"
}

