--- a/app/service.py
+++ b/app/service.py
@@ -1,8 +1,19 @@
+from pathlib import PurePosixPath
+
 from app.models import Page
 
 
 def render_page(theme: str, loader, catalog, template_name: str | None = None) -> Page:
+    if template_name is not None:
+        path = PurePosixPath(template_name)
+        if (
+            path.is_absolute()
+            or len(path.parts) < 2
+            or path.parts[0] != "tenant"
+            or ".." in path.parts
+        ):
+            raise ValueError("template_name must be in the tenant namespace")
     selected = (
         template_name if template_name is not None else catalog.builtin(theme)
     )
     return Page(template=selected, body=loader.load(selected))
