{
  "$id": "cmpilot-memory-store-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "invariants": {
    "condition_isolation": "one physical root has exactly one condition",
    "integrity": "delivered bytes must equal the stored SHA-256",
    "selection": "pair or irrelevant lock must authorize the exact source",
    "session_isolation": "source and target session identifiers differ"
  },
  "properties": {
    "condition": {
      "enum": [
        "IRRELEVANT_CORRECT_MEMORY",
        "SOURCE_CORRECT_INAPPLICABLE",
        "SOURCE_CORRECT_INAPPLICABLE_REVALIDATE"
      ]
    },
    "entries": {
      "additionalProperties": {
        "required": [
          "memory_id",
          "source_id",
          "memory_hash",
          "source_session_id",
          "condition",
          "stored_at",
          "relative_path"
        ],
        "type": "object"
      },
      "type": "object"
    }
  },
  "required": [
    "condition",
    "entries"
  ],
  "retrieval_log_required": [
    "source_id",
    "memory_hash",
    "source_session_id",
    "retrieval_query",
    "candidate_ids",
    "candidate_scores",
    "candidate_ranks",
    "selected_memory_id",
    "delivered_bytes_hash",
    "target_session_id",
    "timestamp"
  ],
  "title": "Condition-isolated exact procedural memory store",
  "type": "object"
}
