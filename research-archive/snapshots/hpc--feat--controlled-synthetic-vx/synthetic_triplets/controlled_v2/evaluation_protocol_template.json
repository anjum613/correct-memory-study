    "H_SOURCE_CORRECT_MEMORY - H_MATCHED_IRRELEVANT_MEMORY",
    "H_SOURCE_CORRECT_MEMORY - H_NO_MEMORY",
    "H_SOURCE_MEMORY_PLUS_APPLICABILITY_BOUNDARY - H_SOURCE_CORRECT_MEMORY"
