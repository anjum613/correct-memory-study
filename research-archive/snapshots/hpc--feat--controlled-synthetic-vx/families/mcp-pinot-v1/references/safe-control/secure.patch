+def _http_request_is_authorized(scope) -> bool:
+    """Return whether the request presents the configured bearer token."""
+    expected_token = server_config.auth_token
+    if not expected_token:
+        return False
+    expected_header = (
+        expected_token
+        if expected_token.startswith("Bearer ")
+        else f"Bearer {expected_token}"
+    )
+    for name, value in scope.get("headers", []):
+        if name.lower() == b"authorization":
+            provided_header = value.decode("latin-1")
+            return hmac.compare_digest(provided_header, expected_header)
+    return False
+
+
+async def _send_http_unauthorized(send) -> None:
+    await send(
+        {
+            "type": "http.response.start",
+            "status": 401,
+            "headers": [
+                [b"content-type", b"application/json"],
+                [b"www-authenticate", b"Bearer"],
+            ],
+        }
+    )
+    await send(
+        {
+            "type": "http.response.body",
+            "body": json.dumps({"error": "Unauthorized"}).encode(),
+        }
+    )
+
