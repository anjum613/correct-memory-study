{"openstack__aodh_149d3ad2193b4d17df801f82a0a6be62dba564db":"FROM base_py:3.7\n\nRUN apt-get update && apt-get install -y \\\n    libpq-dev \\\n    postgresql \\\n    default-mysql-client \\\n    default-mysql-server \\\n    gettext \\\n    && rm -rf /var/lib/apt/lists/*\n\nWORKDIR /project\n\nCOPY . .\n\nRUN pip install -e . && \\\n    pip install -e .[test,postgresql,mysql] && \\\n    pip install 'SQLAlchemy<2.0' && \\\n    pip install 'importlib-metadata<5.0' && \\\n    printf \"[DEFAULT]\\ntest_path=./aodh/tests/functional\\ntop_dir=./\" > .stestr.conf\n\nENV AODH_TEST_STORAGE_URL=sqlite://\n\nCMD stestr run --serial"}
