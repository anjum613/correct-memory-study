{"tensorflow__tensorflow_dbdd98c37bc25249e8f288bd30d01e118a7b4498":"FROM base_py:3.9\n\n# Install system dependencies\nRUN apt-get update && apt-get install -y \\\n    default-jdk \\\n    curl \\\n    && rm -rf /var/lib/apt/lists/*\n\nWORKDIR /project\n\nCOPY . .\n\n# Install Python dependencies\nRUN pip3 install --upgrade setuptools wheel six \"numpy~=1.19.2\" protobuf absl-py grpcio\n\n# Install Bazel 5.1.1\nRUN cd /tmp && \\\n    curl -fSsL -O https://github.com/bazelbuild/bazel/releases/download/5.1.1/bazel-5.1.1-installer-linux-x86_64.sh && \\\n    chmod +x bazel-5.1.1-installer-linux-x86_64.sh && \\\n    ./bazel-5.1.1-installer-linux-x86_64.sh && \\\n    rm bazel-5.1.1-installer-linux-x86_64.sh\n\n# Fix numpy compatibility issue\nRUN cd /usr/local/lib/python3.9/site-packages/numpy && \\\n    ln -sf core _core && \\\n    touch _core/include/numpy/__multiarray_api.c\n\nRUN bazel build --jobs=4 --local_ram_resources=8192 --local_cpu_resources=8 //tensorflow/python/kernel_tests/summary_ops:summary_ops_test 2>&1 | tail -50\n\nCMD bazel test --jobs=4 --local_ram_resources=8192 --local_cpu_resources=8 //tensorflow/python/kernel_tests/summary_ops:summary_ops_test --test_output=errors"}
