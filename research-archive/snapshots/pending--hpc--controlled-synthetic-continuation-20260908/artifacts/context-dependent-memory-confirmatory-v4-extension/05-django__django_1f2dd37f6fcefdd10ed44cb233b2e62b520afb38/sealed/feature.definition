{"django__django_1f2dd37f6fcefdd10ed44cb233b2e62b520afb38":"FROM base_py:3.8\n\nRUN apt-get update && apt-get install -y \\\n    libmemcached-dev \\\n    zlib1g-dev \\\n    && rm -rf /var/lib/apt/lists/*\n\nWORKDIR /project\n\nCOPY . .\n\nRUN python -m pip install -e . && \\\n    python -m pip install -r tests/requirements/py3.txt\n\nCMD cd tests && python runtests.py -v2 --parallel 2 admin_widgets"}
