#!/usr/bin/bash
set -euo pipefail

# Exact status assignments and uses from the submitted job-25692 finalizer.
SERVER_PID=
GPU_MONITOR_PID=
PROCESS_MONITOR_PID=
FAIL_LABEL=QWEN32B_CALCULATOR_TECHNICAL_FAIL
FAIL_MESSAGE='calculator diagnostic exited before a technically valid result'
true
SCRIPT_OBSERVATION_STATUS=$?
if (( SCRIPT_OBSERVATION_STATUS != 0 )); then exit 1; fi
true
VERIFIER_BOOTSTRAP_STATUS=$?
if (( VERIFIER_BOOTSTRAP_STATUS != 0 )); then exit 1; fi
true
MANIFEST_BOOTSTRAP_STATUS=$?
if (( MANIFEST_BOOTSTRAP_STATUS != 0 )); then exit 1; fi
true
RUNTIME_SOURCE_STATUS=$?
if (( RUNTIME_SOURCE_STATUS != 0 )); then exit 1; fi
true
PORT_STATUS=$?
if (( PORT_STATUS != 0 )); then exit 1; fi
true
SERVER_COMMAND_EXTRACTION_STATUS=$?
if (( SERVER_COMMAND_EXTRACTION_STATUS != 0 )); then exit 1; fi
/usr/bin/printf '%s\n' "$SERVER_PID" "$GPU_MONITOR_PID" "$PROCESS_MONITOR_PID"
/usr/bin/printf '%s\n' "$FAIL_LABEL" "$FAIL_MESSAGE"
agent_start_ns=$(/usr/bin/date +%s%N)
set +e
true
SMOKE_STATUS=$?
set -e
if (( SMOKE_STATUS == 2 )); then exit 100; fi

set +e
true
ANALYSIS_STATUS=$?
if (( ANALYSIS_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
POLICY_AUDIT_STATUS=$?
if (( POLICY_AUDIT_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
FINAL_COLLECTION_STATUS=0
true
PATCH_HASH_STATUS=$?
if (( PATCH_HASH_STATUS != 0 )); then FINAL_COLLECTION_STATUS=1; fi
if (( FINAL_COLLECTION_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
MINI_SOURCE_CAPTURE_STATUS=$?
true
MINI_SOURCE_COMPARE_STATUS=$?
if (( MINI_SOURCE_CAPTURE_STATUS != 0 || MINI_SOURCE_COMPARE_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
SHUTDOWN_STATUS=$?
if (( SHUTDOWN_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
FINAL_PROCESS_STATUS=$?
if (( FINAL_PROCESS_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
FINAL_MINI_PROCESS_STATUS=$?
if (( FINAL_MINI_PROCESS_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
GPU_RELEASE_STATUS=$?
if (( GPU_RELEASE_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
CACHE_FINAL_STATUS=$?
if (( CACHE_FINAL_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
SOURCE_INTEGRITY_STATUS=$?
if (( SOURCE_INTEGRITY_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
POST_FINGERPRINT_STATUS=$?
if (( POST_FINGERPRINT_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
true
POST_CONTENT_STATUS=$?
if (( POST_CONTENT_STATUS != 0 )); then
    POST_AGENT_FAILURE_COUNT=$((POST_AGENT_FAILURE_COUNT - -1))
fi
/usr/bin/printf '%s\n' "$POST_AGENT_FAILURE_COUNT"
true
PRESERVATION_STATUS=$?
true
SCRATCH_CLEANUP_STATUS=$?
FINAL_LABEL=QWEN32B_CALCULATOR_MODEL_FAIL
/usr/bin/printf '%s\n' "$PRESERVATION_STATUS" "$SCRATCH_CLEANUP_STATUS" "$FINAL_LABEL"
