+"""Case-sensitive handle identities under the pinned Unicode NFC policy."""
+import unicodedata
+
+
+UNICODE_VERSION = '15.0.0'
+
+
+def _valid(handle):
+    return (
+        isinstance(handle, str)
+        and 1 <= len(handle) <= 32
+        and all(
+            character in '_-'
+            or unicodedata.category(character)[0] in {'L', 'M', 'N'}
+            for character in handle
+        )
+    )
+
+
+def _key(handle):
+    return unicodedata.normalize('NFC', handle)
+
+
+def _matches(rows, key):
+    # Rebuild from authoritative bindings so legacy raw keys and externally
+    # supplied registries participate in the same uniqueness relation.
+    return [raw for raw in rows if isinstance(raw, str) and _key(raw) == key]
+
+
+def run(registry, operation, handle, argument=None):
+    if unicodedata.unidata_version != UNICODE_VERSION:
+        return 'invalid'
+    if not _valid(handle):
+        return 'invalid'
+    rows = registry.rows
+    key = _key(handle)
+    matches = _matches(rows, key)
+
+    if operation == 'register':
+        if matches:
+            return 'exists'
+        rows[key] = {'owner': argument, 'display': handle}
+        return 'registered'
+
+    if operation == 'lookup':
+        if len(matches) != 1:
+            return None
+        return rows[matches[0]]['owner']
+
+    if operation == 'rename':
+        if not isinstance(argument, (tuple, list)) or len(argument) != 2:
+            return 'invalid'
+        owner, new_handle = argument
+        if not _valid(new_handle):
+            return 'invalid'
+        if len(matches) != 1:
+            return 'forbidden'
+        old_key = matches[0]
+        row = rows[old_key]
+        if row['owner'] != owner:
+            return 'forbidden'
+        new_key = _key(new_handle)
+        destinations = _matches(rows, new_key)
+        if any(destination != old_key for destination in destinations):
+            return 'exists'
+        replacement = dict(row)
+        replacement['display'] = new_handle
+        del rows[old_key]
+        rows[new_key] = replacement
+        return 'renamed'
+
+    return 'invalid'
