{"vyperlang__vyper_851f7a1b3aa2a36fd041e3d0ed38f9355a58c8ae":"FROM base_py:3.10\n\nRUN apt-get update && \\\n    apt-get install -y --no-install-recommends \\\n        apt-utils \\\n        gcc \\\n        git \\\n        libc6-dev \\\n        libc-dev \\\n        libssl-dev \\\n        libgmp-dev \\\n    && rm -rf /var/lib/apt/lists/*\n\nWORKDIR /project\n\nCOPY . .\n\nRUN pip install --no-cache-dir .[test]\n\nCMD python -m pytest tests/parser/functions/ -m \"not fuzzing\" -n 2"}
