{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-trust-transition-packet-v0.1",
  "type": "object",
  "required": [
    "seed_id",
    "advisory_id",
    "advisory_source_revision",
    "repository",
    "language",
    "security_category",
    "fix_anchor",
    "relationships",
    "historical_changes",
    "test_infrastructure",
    "raw_evidence",
    "unresolved_fields",
    "history_assessment"
  ],
  "properties": {
    "seed_id": {"type": "string"},
    "advisory_id": {"type": "string"},
    "advisory_source_revision": {"type": "string"},
    "repository": {"type": "string"},
    "language": {"type": "string"},
    "security_category": {"type": "string"},
    "fix_anchor": {
      "type": "object",
      "required": ["commit", "PR", "issue", "date", "affected_files", "source_files", "test_files"]
    },
    "relationships": {"type": "array"},
    "historical_changes": {"type": "array"},
    "test_infrastructure": {"type": "object"},
    "raw_evidence": {"type": "array"},
    "unresolved_fields": {"type": "array"},
    "history_assessment": {"enum": ["ENOUGH_HISTORY", "THIN_HISTORY", "NO_USEFUL_HISTORY"]}
  },
  "additionalProperties": true
}
