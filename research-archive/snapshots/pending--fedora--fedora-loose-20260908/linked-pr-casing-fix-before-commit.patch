+        source_kind="TRUST_BOUNDARY_ISSUE_PR_SEARCH",
+        source_revision={
+            "kind": "FROZEN_QUERY_SPECIFICATION",
+            "value": "b" * 64,
+        },
+        token=FIXTURE_TOKEN,
+    )
+    snapshot, head, repair = "a" * 40, "b" * 40, "c" * 40
+    snapshot_tree, repair_tree = "d" * 40, "e" * 40
+
+    def transport(method, url, headers, body):  # type: ignore[no-untyped-def]
+        del headers
+        parsed = urlsplit(url)
+        if parsed.path == "/search/issues":
+            query = parse_qs(parsed.query)["q"][0]
+            items = (
+                [
+                    {
+                        "id": 86,
+                        "node_id": "issue-node-86",
+                        "number": 86,
+                        "repository_url": (
+                            "https://api.github.com/repos/issueowner/issues"
+                        ),
+                        "url": (
+                            "https://api.github.com/repos/issueowner/issues/issues/86"
+                        ),
+                        "html_url": "https://github.com/issueowner/issues/issues/86",
+                    }
+                ]
+                if '"fixture-0"' in query
+                else []
+            )
+            return _response(
+                {
+                    "total_count": len(items),
+                    "incomplete_results": False,
+                    "items": items,
+                }
+            )
+        if parsed.path == "/graphql":
+            assert method == "POST"
+            assert body is not None
+            return _response(
+                {
+                    "data": {
+                        "repository": {
+                            "databaseId": 11,
+                            "nameWithOwner": "issueowner/issues",
+                            "issue": {
+                                "closedByPullRequestsReferences": {
+                                    "nodes": [
+                                        {
+                                            "id": "pull-request-node-9",
+                                            "number": 9,
+                                            "merged": True,
+                                            "mergedAt": "2026-01-01T00:00:00Z",
+                                            "baseRefOid": "f" * 40,
+                                            "headRefOid": head,
+                                            "mergeCommit": {"oid": repair},
+                                            "repository": {
+                                                "databaseId": 7,
+                                                "nameWithOwner": graphql_name_with_owner,
+                                                "url": (
+                                                    "https://github.com/"
+                                                    f"{graphql_name_with_owner}"
+                                                ),
+                                                "visibility": "PUBLIC",
+                                            },
+                                        }
+                                    ],
+                                    "pageInfo": {
+                                        "hasNextPage": False,
+                                        "endCursor": None,
+                                    },
+                                }
+                            },
+                        }
+                    }
+                }
+            )
+        if parsed.path == "/repos/issueowner/issues":
+            return _response(
+                {
+                    "id": 11,
+                    "owner": {"login": "issueowner"},
+                    "name": "issues",
+                    "html_url": "https://github.com/issueowner/issues",
+                    "visibility": "public",
+                }
+            )
+        if parsed.path.casefold() == "/repos/exampleowner/examplerepository":
+            return _response(
+                {
+                    "id": 7,
+                    "owner": {"login": "exampleowner"},
+                    "name": "examplerepository",
+                    "html_url": (
+                        "https://github.com/exampleowner/examplerepository"
+                    ),
+                    "visibility": "public",
+                }
+            )
+        api_root = f"/repos/{graphql_name_with_owner}"
+        if parsed.path == f"{api_root}/pulls/9":
+            return _response(
+                {
+                    "number": 9,
+                    "merged": True,
+                    "merged_at": "2026-01-01T00:00:00Z",
+                    "commits": 2,
+                    "base": {"sha": "f" * 40},
+                    "head": {"sha": head},
+                    "merge_commit_sha": repair,
+                }
+            )
+        if parsed.path == f"{api_root}/pulls/9/commits":
+            return _response([{"sha": "1" * 40}, {"sha": head}])
+        if parsed.path == f"{api_root}/git/commits/{repair}":
+            return _response(
+                {
+                    "sha": repair,
+                    "tree": {"sha": repair_tree},
+                    "parents": [{"sha": snapshot}, {"sha": head}],
+                }
+            )
+        if parsed.path == f"{api_root}/git/trees/{repair_tree}":
+            return _response({"sha": repair_tree, "tree": []})
+        if parsed.path == f"{api_root}/git/commits/{snapshot}":
+            return _response(
+                {
+                    "sha": snapshot,
+                    "tree": {"sha": snapshot_tree},
+                    "parents": [],
+                }
+            )
+        if parsed.path == f"{api_root}/git/trees/{snapshot_tree}":
+            return _response({"sha": snapshot_tree, "tree": []})
+        raise AssertionError(f"unexpected offline request: {method} {url}")
+
+    context.api.transport = transport
+    context.api.clock = lambda: "2026-08-16T00:00:00Z"
