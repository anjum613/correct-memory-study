+def test_linked_pr_repository_casing_matches_rest_materialization(
+    tmp_path: Path,
+) -> None:
+    mixed_context, mixed_evidence, mixed_records, mixed_occurrences = (
+        _capture_and_materialize_linked_pr_case(
+            tmp_path / "mixed",
+            graphql_name_with_owner="ExampleOwner/ExampleRepository",
+        )
+    )
+    _, control_evidence, control_records, control_occurrences = (
+        _capture_and_materialize_linked_pr_case(
+            tmp_path / "control",
+            graphql_name_with_owner="exampleowner/examplerepository",
+        )
+    )
+
+    assert len(mixed_records) == len(control_records) == 1
+    assert mixed_records[0]["disposition"] == "MATERIALIZED"
+    assert mixed_records[0]["rejection_reason_codes"] == []
+    assert mixed_records[0]["candidate_links"] == control_records[0]["candidate_links"]
+    assert len(mixed_occurrences) == len(control_occurrences) == 1
+    for field in (
+        "canonical_candidate_id",
+        "github_repository_id",
+        "candidate_snapshot_commit_sha",
+        "repair_commit_sha",
+        "pull_request_number",
+        "repository_capture_metadata",
+        "topology",
+    ):
+        assert mixed_occurrences[0][field] == control_occurrences[0][field]
+
+    linked_pr_path = "/repos/ExampleOwner/ExampleRepository/pulls/9"
+    mixed_linked_requests = [
+        request
+        for request in mixed_context.api.requests
+        if urlsplit(str(request["endpoint"])).path.casefold()
+        == linked_pr_path.casefold()
+    ]
+    assert len(mixed_linked_requests) == 1
+    assert urlsplit(str(mixed_linked_requests[0]["endpoint"])).path == linked_pr_path
+    assert len(mixed_evidence.entries) == len(control_evidence.entries)
+    assert len({entry["evidence_key"] for entry in mixed_evidence.entries}) == len(
+        mixed_evidence.entries
+    )
+
+    repository_paths = [
+        urlsplit(str(request["endpoint"])).path
+        for request in mixed_context.api.requests
+    ]
+    assert "/repos/ExampleOwner/ExampleRepository" in repository_paths
+    graphql_entry = next(
+        entry
+        for entry in mixed_evidence.entries
+        if entry.get("request_body") is not None
+    )
+    graphql_payload = mixed_evidence.read_payload(
+        root=mixed_context.root, entry=graphql_entry
+    )
+    assert isinstance(graphql_payload, dict)
+    linked_repository = graphql_payload["data"]["repository"]["issue"][
+        "closedByPullRequestsReferences"
+    ]["nodes"][0]["repository"]
+    assert linked_repository["nameWithOwner"] == (
+        "ExampleOwner/ExampleRepository"
+    )
