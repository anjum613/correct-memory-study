+def _capture_and_materialize_linked_pr_case(
+    run_root: Path, *, graphql_name_with_owner: str
+) -> tuple[
+    CaptureContext,
+    GitHubEvidence,
+    list[dict[str, object]],
+    list[dict[str, object]],
+]:
+    context = CaptureContext.create(
+        run_root=run_root,
