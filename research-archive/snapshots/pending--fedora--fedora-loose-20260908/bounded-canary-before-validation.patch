+def _materialize_canary_object_ledger(
+    context: CaptureContext, budget: OperationalCanaryBudget
+) -> dict[str, Any]:
+    """Create a non-scientific, deterministic ledger of captured objects."""
+
+    objects: list[dict[str, Any]] = []
+    for source_object in context.source_objects:
+        budget.checkpoint()
+        objects.append(
+            {
+                "source_object_id": source_object["source_object_id"],
+                "source_native_identity": source_object["source_native_identity"],
+                "query_id": source_object["query_id"],
+                "search_evidence_key": source_object["search_evidence_key"],
+            }
+        )
+    return {
+        "schema": "candidate-discovery-operational-canary-object-ledger-v0.1",
+        "status": "CANARY_OPERATIONAL_OBJECT_LEDGER_COMPLETE",
+        "operational_canary": True,
+        "scientific_candidate_materialization_performed": False,
+        "candidate_selection_performed": False,
+        "source_object_count": len(objects),
+        "objects": objects,
+    }
+
