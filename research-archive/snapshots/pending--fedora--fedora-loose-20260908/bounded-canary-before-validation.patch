+def _capture_canary_search_page(
+    evidence: GitHubEvidence,
+    *,
+    query_id: str,
+    query_text: str,
+) -> tuple[Mapping[str, Any], dict[str, Any]]:
+    """Capture one non-partitioned page using the exact frozen query text."""
+
+    payload, entry = evidence.capture(
+        method="GET",
+        endpoint="https://api.github.com/search/issues",
+        ordered_parameters=(
+            ("q", query_text),
+            ("sort", "created"),
+            ("order", "asc"),
+            ("per_page", "100"),
+            ("page", "1"),
+        ),
+        exact_query=query_text,
+        page=1,
+        sort="created",
+        order="asc",
+        allow_one_redirect=False,
+        capture_scope=f"operational-canary:{query_id}:single-search-response",
+    )
+    if not isinstance(payload, Mapping):
+        raise DiscoveryExecutionError(
+            "GITHUB_SEARCH_RESPONSE_MALFORMED", "canary response is not an object"
+        )
+    total = payload.get("total_count")
+    incomplete = payload.get("incomplete_results")
+    items = payload.get("items")
+    if (
+        isinstance(total, bool)
+        or not isinstance(total, int)
+        or total < 0
+        or not isinstance(incomplete, bool)
+        or not isinstance(items, list)
+    ):
+        raise DiscoveryExecutionError(
+            "GITHUB_SEARCH_RESPONSE_MALFORMED", "canary envelope is malformed"
+        )
+    return payload, entry
+
+
+def capture_search_canary(
+    context: CaptureContext,
+    evidence: GitHubEvidence,
+    *,
+    query: Mapping[str, Any],
+    budget: OperationalCanaryBudget,
+) -> None:
+    """Capture one bounded Search sample without a scientific coverage claim."""
+
+    query_id = str(query["query_id"])
+    query_text = str(query["query"])
+    object_type = str(query["object_type"])
+    context.source_capture = {
+        "schema": "github-search-operational-canary-capture-v0.1",
+        "operational_canary": True,
+        "scientific_candidate_discovery_protocol": False,
+        "complete_population_claim": False,
+        "query_id": query_id,
+        "query_text": query_text,
+        "query_sha256": sha256_bytes(query_text.encode("utf-8")),
+        "source": "Search",
+        "page": 1,
+        "per_page": 100,
+        "recursive_partitioning_allowed": False,
+        "recapture_allowed": False,
+        "pagination_allowed": False,
+    }
+    budget.checkpoint()
+    payload, entry = _capture_canary_search_page(
+        evidence,
+        query_id=query_id,
+        query_text=query_text,
+    )
+    metadata = _request_observation_metadata(context, entry)
+    total = int(payload["total_count"])
+    incomplete = bool(payload["incomplete_results"])
+    items = payload["items"]
+    identities = [_search_item_identity(item) for item in items]
+    context.source_capture.update(
+        {
+            "reported_total_count": total,
+            "returned_item_count": len(items),
+            "unique_item_count": len(set(identities)),
+            "incomplete_results": incomplete,
+            "request_number": metadata["request_number"],
+            "raw_response_sha256": metadata["raw_response_sha256"],
+            "capture_started_at_utc": metadata["capture_started_at_utc"],
+            "capture_completed_at_utc": metadata["capture_completed_at_utc"],
+        }
+    )
+    context.partition_nodes.append(
+        {
+            "query_id": query_id,
+            "path": "",
+            "disposition": "OPERATIONAL_CANARY_SINGLE_RESPONSE",
+            "reported_total_count": total,
+            "returned_item_count": len(items),
+            "incomplete_results": incomplete,
+            "request_number": metadata["request_number"],
+            "raw_response_sha256": metadata["raw_response_sha256"],
+            "scientific_coverage_claim": False,
+        }
+    )
+
+    if incomplete:
+        context.source_capture["blocked_follow_up_reason"] = (
+            "INCOMPLETE_RESULTS_RECAPTURE_WOULD_REQUIRE_SECOND_SEARCH_REQUEST"
+        )
+        budget.begin_logical_request("https://api.github.com/search/issues")
+    if total > TERMINAL_LEAF_RESULT_CAP:
+        context.source_capture["blocked_follow_up_reason"] = (
+            "RECURSIVE_PARTITION_WOULD_REQUIRE_SECOND_SEARCH_REQUEST"
+        )
+        budget.begin_logical_request("https://api.github.com/search/issues")
+
+    observed: list[tuple[dict[str, Any], Mapping[str, Any]]] = []
+    seen_node_ids: set[str] = set()
+    for item_index, item in enumerate(items):
+        node_id = identities[item_index]
+        if node_id in seen_node_ids:
+            continue
+        seen_node_ids.add(node_id)
+        observed.append(
+            (
+                {
+                    "query_id": query_id,
+                    "node_id": node_id,
+                    "partition_path": "",
+                    "page": 1,
+                    "item_index": item_index,
+                    "search_evidence_key": entry["evidence_key"],
+                    "request_number": metadata["request_number"],
+                    "raw_response_sha256": metadata["raw_response_sha256"],
+                    "capture_completed_at_utc": metadata[
+                        "capture_completed_at_utc"
+                    ],
+                },
+                _mapping(item, "search item"),
+            )
+        )
+
+    for item_ref, item in observed:
+        budget.begin_source_object()
+        context.add_source_object(
+            {
+                "source_object_id": f"GITHUB_SEARCH:{item_ref['node_id']}",
+                "source_native_identity": {
+                    "api_version": API_VERSION,
+                    "github_search_node_id": item_ref["node_id"],
+                },
+                **item_ref,
+                "observed_query_ids": [query_id],
+                "observed_leaf_provenance": [dict(item_ref)],
+                "operational_canary": True,
+            }
+        )
+        try:
+            owner, repository = _repository_coordinates_from_api_url(
+                item.get("repository_url")
+            )
+            number = _positive_int(item.get("number"), "search item number")
+        except DiscoveryExecutionError:
+            continue
+        if object_type == "PULL_REQUEST":
+            repository_payload, _ = _capture_repository(evidence, owner, repository)
+            if repository_payload is None:
+                continue
+            try:
+                normalized = _normalized_repository_payload(repository_payload)
+            except SourceRecordRejected:
+                continue
+            _capture_pull_request(
+                evidence,
+                str(normalized["owner"]),
+                str(normalized["name"]),
+                number,
+            )
+        elif object_type == "ISSUE":
+            nodes = _capture_issue_relations(
+                evidence,
+                owner=owner,
+                repository=repository,
+                number=number,
+            )
+            repository_payload, _ = _capture_repository(evidence, owner, repository)
+            if repository_payload is None:
+                continue
+            for node in nodes:
+                repository_node = node.get("repository")
+                name_with_owner = (
+                    repository_node.get("nameWithOwner")
+                    if isinstance(repository_node, Mapping)
+                    else None
+                )
+                pr_number = node.get("number")
+                if (
+                    isinstance(name_with_owner, str)
+                    and name_with_owner.count("/") == 1
+                    and isinstance(pr_number, int)
+                    and not isinstance(pr_number, bool)
+                    and pr_number > 0
+                ):
+                    pr_owner, pr_repository = name_with_owner.split("/", 1)
+                    _capture_repository(evidence, pr_owner, pr_repository)
+                    _capture_pull_request(
+                        evidence, pr_owner, pr_repository, pr_number
+                    )
+        else:
+            raise DiscoveryExecutionError(
+                "SOURCE_SCHEMA_DRIFT", "query object_type is invalid"
+            )
+
