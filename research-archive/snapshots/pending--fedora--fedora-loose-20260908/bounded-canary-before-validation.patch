+def _selected_canary_query(
+    search_spec: Mapping[str, Any], query_id: str
+) -> Mapping[str, Any]:
+    """Return exactly one unchanged query from the frozen eight-query spec."""
+
+    queries = search_spec.get("queries")
+    if not isinstance(queries, list) or len(queries) != 8:
+        raise DiscoveryExecutionError(
+            "SOURCE_SCHEMA_DRIFT", "frozen search specification must have eight queries"
+        )
+    selected: list[Mapping[str, Any]] = []
+    seen_ids: set[str] = set()
+    for raw_query in queries:
+        query = _mapping(raw_query, "query specification")
+        candidate_id = query.get("query_id")
+        query_text = query.get("query")
+        object_type = query.get("object_type")
+        if (
+            not isinstance(candidate_id, str)
+            or not isinstance(query_text, str)
+            or object_type not in {"ISSUE", "PULL_REQUEST"}
+            or candidate_id in seen_ids
+        ):
+            raise DiscoveryExecutionError(
+                "SOURCE_SCHEMA_DRIFT", "frozen query specification is malformed"
+            )
+        seen_ids.add(candidate_id)
+        if candidate_id == query_id:
+            selected.append(query)
+    if len(selected) != 1:
+        raise DiscoveryExecutionError(
+            "CANARY_QUERY_ID_INVALID",
+            "canary query ID must select exactly one frozen query",
+        )
+    return selected[0]
+
