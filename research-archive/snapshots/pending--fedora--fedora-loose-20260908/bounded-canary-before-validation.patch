+@dataclass
+class OperationalCanaryBudget:
+    """Fail-closed counters and monotonic deadline for an operational canary."""
+
+    maximum_search_requests: int = 1
+    maximum_source_objects: int = 5
+    maximum_api_attempts: int = 100
+    deadline_seconds: float = 2100
+    monotonic: MonotonicClock = time.monotonic
+    search_requests: int = field(default=0, init=False)
+    source_objects: int = field(default=0, init=False)
+    api_attempts: int = field(default=0, init=False)
+    termination_reason: str | None = field(default=None, init=False)
+    started_monotonic: float = field(init=False)
+
+    def __post_init__(self) -> None:
+        if (
+            self.maximum_search_requests <= 0
+            or self.maximum_source_objects <= 0
+            or self.maximum_api_attempts <= 0
+            or self.deadline_seconds <= 0
+        ):
+            raise DiscoveryExecutionError(
+                "CANARY_CONFIGURATION_INVALID",
+                "operational canary limits must be positive",
+            )
+        self.started_monotonic = self.monotonic()
+
+    @property
+    def deadline_monotonic(self) -> float:
+        return self.started_monotonic + self.deadline_seconds
+
+    def elapsed_seconds(self) -> float:
+        return max(0.0, self.monotonic() - self.started_monotonic)
+
+    def remaining_seconds(self) -> float:
+        return max(0.0, self.deadline_monotonic - self.monotonic())
+
+    def configured_limits(self) -> dict[str, int | float]:
+        return {
+            "maximum_search_requests": self.maximum_search_requests,
+            "maximum_source_objects": self.maximum_source_objects,
+            "maximum_api_attempts": self.maximum_api_attempts,
+            "deadline_seconds": self.deadline_seconds,
+        }
+
+    def observed_counts(self) -> dict[str, int]:
+        return {
+            "actual_search_requests": self.search_requests,
+            "actual_source_objects": self.source_objects,
+            "actual_physical_api_attempts": self.api_attempts,
+        }
+
+    def _stop(self, code: str) -> None:
+        if self.termination_reason is None:
+            self.termination_reason = code
+        raise DiscoveryExecutionError(code, "operational canary hard bound reached")
+
+    def checkpoint(self) -> None:
+        if self.monotonic() >= self.deadline_monotonic:
+            self._stop("CANARY_RUNTIME_LIMIT_REACHED")
+
+    def begin_logical_request(self, endpoint: str) -> None:
+        """Reserve a Search logical request before any wait or transport."""
+
+        self.checkpoint()
+        if _github_rate_limit_resource(endpoint) != "search":
+            return
+        if self.search_requests >= self.maximum_search_requests:
+            self._stop("CANARY_SEARCH_REQUEST_LIMIT_REACHED")
+        self.search_requests += 1
+
+    def begin_source_object(self) -> None:
+        """Reserve a source object before any of its detail requests."""
+
+        self.checkpoint()
+        if self.source_objects >= self.maximum_source_objects:
+            self._stop("CANARY_SOURCE_OBJECT_LIMIT_REACHED")
+        self.source_objects += 1
+
+    def before_transport(self) -> None:
+        """Reserve one physical API attempt immediately before transport."""
+
