+def fold(c):
+    if 65 <= c and c <= 90:
+        return c + 32
+    return c
+
+def alpha(c):
+    return (65 <= c and c <= 90) or (97 <= c and c <= 122)
+
+def same(a, b):
+    if m[0] == 1 and alpha(a) and alpha(b):
+        return fold(a) == fold(b)
