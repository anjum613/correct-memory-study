+    m[current_mark + start_state] = 1
+    m[queue] = start_state
+    apply_closure(current_mark, queue, 1)
+    index = 0
+    byte_pos = rec_start
+    while index < rec_len:
+        clear_region(next_mark, state_count)
+        top = 0
+        state_id = 0
+        byte = m[byte_pos]
+        while state_id < state_count:
+            if m[current_mark + state_id] == 1:
+                kind = state_kind(state_id)
+                if kind != 0:
+                    if state_char_match(state_id, byte) == 1:
+                        target = state_out1(state_id)
+                        if target >= 0:
+                            mark_address = next_mark + target
+                            if m[mark_address] == 0:
+                                m[mark_address] = 1
+                                m[queue + top] = target
+                                top = top + 1
+            state_id = state_id + 1
+        if top == 0:
+            return 0
+        apply_closure(next_mark, queue, top)
+        temp = current_mark
+        current_mark = next_mark
+        next_mark = temp
+        index = index + 1
+        byte_pos = byte_pos + 1
+    if m[current_mark + accept_state] == 1:
+        return 1
+    return 0
+
