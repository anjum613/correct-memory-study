+def apply_closure(mark_base, queue_base, queue_count):
+    top = queue_count
+    while top != 0:
+        top = top - 1
+        state_id = m[queue_base + top]
+        if state_kind(state_id) == 0:
+            first = state_out1(state_id)
+            if first >= 0:
+                mark_address = mark_base + first
+                if m[mark_address] == 0:
+                    m[mark_address] = 1
+                    m[queue_base + top] = first
+                    top = top + 1
+            second = state_out2(state_id)
+            if second >= 0:
+                mark_address = mark_base + second
+                if m[mark_address] == 0:
+                    m[mark_address] = 1
+                    m[queue_base + top] = second
+                    top = top + 1
+
