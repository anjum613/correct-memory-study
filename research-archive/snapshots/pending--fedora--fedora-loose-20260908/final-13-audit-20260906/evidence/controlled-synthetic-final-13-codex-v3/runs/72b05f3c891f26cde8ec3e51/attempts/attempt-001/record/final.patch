+def is_reserved_outside(value):
+    return value == 46 or value == 91 or value == 93 or value == 40 or value == 41 or value == 124 or value == 42 or value == 43 or value == 63 or value == 92 or value == 94 or value == 36 or value == 123 or value == 125
+
+
+def is_reserved_class(value):
+    return value == 91 or value == 93 or value == 92 or value == 45 or value == 94
+
+
+def is_printable(value):
+    return 32 <= value and value <= 126
+
+
+def is_ascii_letter(byte):
