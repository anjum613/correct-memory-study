+def parse_sequence(stop_char):
+    if g_invalid == 1:
+        return -1
+    if g_pat_pos >= g_pat_len:
+        return build_empty_frag()
+    current = m[g_pat_base + g_pat_pos]
+    if current == 124 or (stop_char != -1 and current == stop_char):
+        return build_empty_frag()
+    first = 1
+    result = -1
+    while g_pat_pos < g_pat_len:
+        current = m[g_pat_base + g_pat_pos]
+        if current == 124 or (stop_char != -1 and current == stop_char):
+            break
+        frag = parse_repetition()
+        if g_invalid == 1:
+            return -1
+        if first == 1:
+            result = frag
+            first = 0
+        else:
+            result = concat_frag(result, frag)
+        if g_invalid == 1:
+            return -1
+    if first == 1:
+        return build_empty_frag()
+    return result
+
