+def interval_match(byte, head):
+    ptr = head
+    while ptr >= 0:
+        start = m[ptr]
+        end = m[ptr + 1]
+        if start <= byte and byte <= end:
+            return 1
+        ptr = m[ptr + 2]
+    return 0
