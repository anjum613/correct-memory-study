+def state_char_match(state_id, byte):
+    kind = state_kind(state_id)
+    if kind == 0:
+        return 0
+    if kind == 2:
+        return 1
+    head = state_data(state_id)
+    complement = state_out2(state_id)
+    matched = interval_match(byte, head)
+    if g_flags == 1 and matched == 0:
+        if 65 <= byte and byte <= 90:
+            matched = interval_match(byte + 32, head)
+        if matched == 0 and 97 <= byte and byte <= 122:
+            matched = interval_match(byte - 32, head)
+    if complement == 1:
+        if matched == 0:
+            return 1
+        return 0
+    return matched
