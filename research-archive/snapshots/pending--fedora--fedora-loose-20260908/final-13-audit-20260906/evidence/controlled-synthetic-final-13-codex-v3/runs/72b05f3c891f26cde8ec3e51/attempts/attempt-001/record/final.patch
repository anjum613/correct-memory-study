+        return -1
+    if g_pat_pos >= g_pat_len:
+        return frag
+    current = m[g_pat_base + g_pat_pos]
+    if current == 42:
+        g_pat_pos = g_pat_pos + 1
+        return star_frag(frag)
+    if current == 43:
+        g_pat_pos = g_pat_pos + 1
+        return plus_frag(frag)
+    if current == 63:
+        g_pat_pos = g_pat_pos + 1
+        return optional_frag(frag)
+    return frag
