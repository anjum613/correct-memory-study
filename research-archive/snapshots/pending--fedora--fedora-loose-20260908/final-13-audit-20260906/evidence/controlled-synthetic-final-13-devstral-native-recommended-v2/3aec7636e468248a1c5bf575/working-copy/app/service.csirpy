def boot():
    def match(pattern_bytes, records, flags):
        pattern = pattern_bytes.decode("ascii")
        records = [record.decode("ascii") for record in records]
        if flags == "ASCII_IGNORE_CASE":
            pattern = pattern.lower()
            records = [record.lower() for record in records]
        selected = tuple(record.encode("ascii") for record in records if pattern == record)
        return selected
    return match

