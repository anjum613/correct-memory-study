def match(start, record):
    current = g_first
    following = g_second
    m[current] = start
    count = 1
    position = 0
    length = m[record]
    while position <= length:
        next_count = 0
        accepted = 0
        g_stamp = g_stamp + 1
        byte = 32
        if position < length:
            byte = m[record + 1 + position]
        while count:
            count = count - 1
            pointer = m[current + count]
            if m[pointer + 3] != g_stamp:
                m[pointer + 3] = g_stamp
                kind = m[pointer]
                if kind == 1:
                    if position < length and m[pointer + 4 + byte - 32] == 1:
                        m[following + next_count] = m[pointer + 1]
                        next_count = next_count + 1
                else:
                    if kind == 0:
                        accepted = 1
                    else:
                        m[current + count] = m[pointer + 1]
                        count = count + 1
                        if kind == 3:
                            m[current + count] = m[pointer + 2]
                            count = count + 1
        if position == length:
            return accepted
        if not next_count:
            return 0
        temporary = current
        current = following
        following = temporary
        count = next_count
        position = position + 1
    return 0
