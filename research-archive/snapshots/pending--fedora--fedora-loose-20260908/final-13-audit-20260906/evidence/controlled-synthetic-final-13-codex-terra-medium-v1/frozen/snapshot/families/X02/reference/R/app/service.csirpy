def node(kind):
    pointer = g_nodes + g_count * 100
    m[pointer] = kind
    g_count = g_count + 1
    return pointer

def fragment(start, head, tail):
    m[g_fragments + g_ftop * 5] = start
    m[g_fragments + g_ftop * 5 + 1] = head
    m[g_fragments + g_ftop * 5 + 2] = tail
    m[g_fragments + g_ftop * 5 + 3] = m[start] == 2
    m[g_fragments + g_ftop * 5 + 4] = m[start] == 2
    g_ftop = g_ftop + 1
    return 0

def patch(head, destination):
    while head != 0:
        following = m[head]
        m[head] = destination
        head = following
    return 0

def combine(operation):
    g_ftop = g_ftop - 2
    left = g_fragments + g_ftop * 5
    right = left + 5
    if operation == 2:
        if m[left + 4] == 1:
            m[left] = m[right]
            m[left + 1] = m[right + 1]
            m[left + 2] = m[right + 2]
            m[left + 3] = m[right + 3]
            m[left + 4] = m[right + 4]
            g_ftop = g_ftop + 1
            return 0
        if m[right + 4] == 1:
            g_ftop = g_ftop + 1
            return 0
    if operation == 1:
        if m[left + 4] == 1 and m[right + 3] == 1:
            m[left] = m[right]
            m[left + 1] = m[right + 1]
            m[left + 2] = m[right + 2]
            m[left + 3] = m[right + 3]
            m[left + 4] = m[right + 4]
            g_ftop = g_ftop + 1
            return 0
        if m[right + 4] == 1 and m[left + 3] == 1:
            g_ftop = g_ftop + 1
            return 0
    if operation == 2:
        m[left + 3] = m[left + 3] and m[right + 3]
        patch(m[left + 1], m[right])
        m[left + 1] = m[right + 1]
        m[left + 2] = m[right + 2]
    else:
        m[left + 3] = m[left + 3] or m[right + 3]
        split = node(3)
        m[split + 1] = m[left]
        m[split + 2] = m[right]
        m[m[left + 2]] = m[right + 1]
        m[left] = split
        m[left + 2] = m[right + 2]
    m[left + 4] = m[left + 4] and m[right + 4]
    g_ftop = g_ftop + 1
    return 0

def operation(priority):
    while g_otop > 0 and m[g_operators + g_otop - 1] >= priority:
        g_otop = g_otop - 1
        combine(m[g_operators + g_otop])
    m[g_operators + g_otop] = priority
    g_otop = g_otop + 1
    return 0

def empty_atom():
    pointer = node(2)
    fragment(pointer, pointer + 1, pointer + 1)
    return 0

def mark_character(pointer, byte):
    m[pointer + 4 + byte - 32] = 1
    if g_flags == 1:
        if byte >= 65 and byte <= 90:
            m[pointer + 4 + byte] = 1
        if byte >= 97 and byte <= 122:
            m[pointer + 4 + byte - 64] = 1
    return 0

def read_character():
    value = m[g_position + 2]
    g_position = g_position + 1
    if value == 92:
        value = m[g_position + 2]
        g_position = g_position + 1
    return value

def compile_pattern():
    g_ftop = 0
    g_otop = 0
    g_position = 0
    previous = 0
    while g_position < g_pattern_length:
        value = m[g_position + 2]
        if value == 124 or value == 41:
            if previous == 0:
                empty_atom()
            if value == 124:
                operation(1)
                previous = 0
            else:
                while m[g_operators + g_otop - 1] != 0:
                    g_otop = g_otop - 1
                    combine(m[g_operators + g_otop])
                g_otop = g_otop - 1
                previous = 1
            g_position = g_position + 1
        else:
            if value == 42 or value == 43 or value == 63:
                top = g_fragments + (g_ftop - 1) * 5
                split = node(3)
                m[split + 1] = m[top]
                if value == 63:
                    m[m[top + 2]] = split + 2
                    m[top + 2] = split + 2
                else:
                    patch(m[top + 1], split)
                    m[top + 1] = split + 2
                    m[top + 2] = split + 2
                if value != 43:
                    m[top + 3] = 1
                    m[top] = split
                g_position = g_position + 1
            else:
                if previous == 1:
                    operation(2)
                if value == 40:
                    m[g_operators + g_otop] = 0
                    g_otop = g_otop + 1
                    g_position = g_position + 1
                    previous = 0
                else:
                    pointer = node(1)
                    if value == 91:
                        g_position = g_position + 1
                        complement = 0
                        if m[g_position + 2] == 94:
                            complement = 1
                            g_position = g_position + 1
                        while m[g_position + 2] != 93:
                            first = read_character()
                            last = first
                            if m[g_position + 2] == 45:
                                g_position = g_position + 1
                                last = read_character()
                            while first <= last:
                                mark_character(pointer, first)
                                first = first + 1
                        if complement == 1:
                            byte = 0
                            while byte < 95:
                                m[pointer + 4 + byte] = not m[pointer + 4 + byte]
                                byte = byte + 1
                        g_position = g_position + 1
                    else:
                        if value == 46:
                            byte = 0
                            while byte < 95:
                                m[pointer + 4 + byte] = 1
                                byte = byte + 1
                            g_position = g_position + 1
                        else:
                            literal = read_character()
                            mark_character(pointer, literal)
                    fragment(pointer, pointer + 1, pointer + 1)
                    previous = 1
    if previous == 0:
        empty_atom()
    while g_otop > 0:
        g_otop = g_otop - 1
        combine(m[g_operators + g_otop])
    accept = node(0)
    patch(m[g_fragments + 1], accept)
    return m[g_fragments]

# Each position has a fresh visitation stamp. Epsilon edges enter the
# current queue; consuming edges seed the next position.
def enqueue(pointer):
    if m[pointer + 99] != g_stamp:
        m[pointer + 99] = g_stamp
        m[g_end] = pointer
        g_end = g_end + 1
    return 0

def match(start, record):
    length = m[record]
    position = 0
    seeds = 1
    m[g_second] = start
    while position <= length and seeds > 0:
        g_stamp = g_stamp + 1
        g_end = g_first
        index = 0
        while index < seeds:
            enqueue(m[g_second + index])
            index = index + 1
        seeds = 0
        index = g_first
        byte = 0
        if position < length:
            byte = m[record + 1 + position] - 32
        while index < g_end:
            current = m[index]
            kind = m[current]
            if kind == 1:
                if position < length and m[current + 4 + byte] == 1:
                    m[g_second + seeds] = m[current + 1]
                    seeds = seeds + 1
            else:
                if kind == 0:
                    if position == length:
                        return 1
                else:
                    enqueue(m[current + 1])
                    if kind == 3:
                        enqueue(m[current + 2])
            index = index + 1
        position = position + 1
    return 0

def boot():
    g_flags = m[0]
    g_pattern_length = m[1]
    g_nodes = alloc(13200)
    g_fragments = alloc(330)
    g_operators = alloc(66)
    g_first = alloc(132)
    g_second = alloc(132)
    output = alloc(9)
    g_count = 0
    g_stamp = 0
    start = compile_pattern()
    count = m[g_pattern_length + 2]
    record = g_pattern_length + 3
    index = 0
    selected = 0
    while index < count:
        result = match(start, record)
        if result == 1:
            m[output + 1 + selected] = index
            selected = selected + 1
        record = record + m[record] + 1
        index = index + 1
    m[output] = selected
    free(g_nodes)
    free(g_fragments)
    free(g_operators)
    free(g_first)
    free(g_second)
    return output
