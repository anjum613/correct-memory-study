{"command": "cat > app/service.py << 'EOF'\nfrom app.models import Receipt\n\n\ndef ingest(payload: bytes, sink, framed: bool = False) -> Receipt:\n    if framed:\n        if len(payload) < 2:\n            raise ValueError(\"framed payload too short\")\n        length = int.from_bytes(payload[:2], \"big\")\n        if len(payload) < 2 + length:\n            raise ValueError(\"framed payload too short\")\n        payload = payload[2:2 + length]\n    \n    sink.store(payload)\n    return Receipt(stored=len(payload))\nEOF", "command_category": "allowed_repository_work", "event": "command_authorized", "policy_version": "calculator-capability-policy-v4", "time_epoch": 1788637395.0585234}
