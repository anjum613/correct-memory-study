{"command": "cat > ./app/service.py << 'EOF'\n\"\"\"Baseline with empty-content behavior and staging feature.\"\"\"\n\n\ndef run(workspace, content_bytes, fault=None):\n    # Create a staged file in the workspace\n    identity = workspace.create(['producer', 'consumer'], content_bytes)\n    \n    # Simulate intentional handoff to consumer\n    if fault == 'handoff':\n        workspace.permissions(identity, ['producer'])\n        return ('error', 'handoff failed')\n    \n    # Simulate write failure\n    if fault == 'write':\n        workspace.permissions(identity, ['producer'])\n        return ('error', 'write failed')\n    \n    # Simulate create failure\n    if fault == 'create':\n        workspace.remove(identity)\n        return ('error', 'create failed')\n    \n    # Normal case: successful staging and handoff\n    if content_bytes == b'':\n        # For empty content, just return ok\n        return ('ok', b'')\n    \n    # For non-empty content, hand off to consumer and return content\n    workspace.permissions(identity, ['consumer'])\n    \n    # Simulate read failure during cleanup\n    if fault == 'read':\n        # In a real scenario, we'd want to simulate cleanup failing\n        # But since we're returning immediately, we'll just return the result\n        pass\n    \n    # Cleanup: remove the file after successful handoff\n    workspace.remove(identity)\n    \n    return ('ok', content_bytes)\nEOF", "command_category": "allowed_repository_work", "event": "command_authorized", "policy_version": "calculator-capability-policy-v4", "time_epoch": 1788640771.594922}
