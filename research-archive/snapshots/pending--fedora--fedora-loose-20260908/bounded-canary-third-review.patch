+def apply_global_deduplication(
+    *,
+    source_records: Mapping[str, list[dict[str, Any]]],
+    occurrences: Sequence[Mapping[str, Any]],
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]], int, list[dict[str, str]]]:
+    """Apply only positive immutable exact collapse and explicit possible links."""
+
+    record_by_id = {
+        record["source_record_id"]: record
+        for records in source_records.values()
+        for record in records
+    }
+    grouped: dict[str, list[Mapping[str, Any]]] = defaultdict(list)
+    for occurrence in occurrences:
+        candidate_id = occurrence.get("canonical_candidate_id")
+        if not isinstance(candidate_id, str) or CANDIDATE_ID_PATTERN.fullmatch(
+            candidate_id
+        ) is None:
+            raise DiscoveryExecutionError("CANDIDATE_ID_INVALID", str(candidate_id))
+        grouped[candidate_id].append(occurrence)
+
+    exact_duplicates = 0
+    pool: list[dict[str, Any]] = []
+    pr_identity: dict[tuple[int, int], str] = {}
+    possible_pairs: set[tuple[str, str]] = set()
+    by_repository_repair: dict[tuple[int, str], list[str]] = defaultdict(list)
+    for candidate_id in sorted(grouped):
+        values = sorted(
+            grouped[candidate_id],
+            key=lambda value: (
+                SOURCE_PRIORITY[str(value["source_id"])],
+                str(value["source_record_id"]),
+            ),
+        )
+        identity = (
+            values[0]["github_repository_id"],
+            values[0]["candidate_snapshot_commit_sha"],
+            values[0]["repair_commit_sha"],
+        )
+        if any(
+            (
+                value["github_repository_id"],
+                value["candidate_snapshot_commit_sha"],
+                value["repair_commit_sha"],
+            )
+            != identity
+            for value in values
+        ):
+            raise DiscoveryExecutionError(
+                "IDENTITY_CONFLICT", f"candidate identity conflict: {candidate_id}"
+            )
+        for position, value in enumerate(values):
+            record = record_by_id[str(value["source_record_id"])]
+            matching_links = [
+                link
+                for link in record["candidate_links"]
+                if link["canonical_candidate_id"] == candidate_id
+            ]
+            if len(matching_links) != 1:
+                raise DiscoveryExecutionError(
+                    "IDENTITY_CONFLICT", "candidate/source link is not one-to-one"
+                )
+            matching_links[0]["deduplication_decision"] = (
+                "NEW_CANONICAL" if position == 0 else "EXACT_DUPLICATE"
+            )
+            if position:
+                exact_duplicates += 1
+            pr_number = value.get("pull_request_number")
+            if isinstance(pr_number, int) and not isinstance(pr_number, bool):
+                key = (int(identity[0]), pr_number)
+                existing = pr_identity.get(key)
+                if existing is not None and existing != candidate_id:
+                    raise DiscoveryExecutionError(
+                        "IDENTITY_CONFLICT",
+                        "one repository/PR resolved to conflicting repair ranges",
+                    )
+                pr_identity[key] = candidate_id
+        by_repository_repair[(int(identity[0]), str(identity[2]))].append(candidate_id)
+        repository_metadata = {
+            canonical_document_bytes(value["repository_capture_metadata"]): dict(
+                value["repository_capture_metadata"]
+            )
+            for value in values
+        }
+        pool.append(
+            {
+                "schema": "raw-candidate-pool-record-v0.3",
+                "protocol_version": PROTOCOL_VERSION,
+                "canonical_candidate_id": candidate_id,
+                "github_repository_id": identity[0],
+                "candidate_snapshot_commit_sha": identity[1],
+                "repair_commit_sha": identity[2],
+                "repository_capture_metadata": [
+                    repository_metadata[key] for key in sorted(repository_metadata)
+                ],
+                "repair_topologies": sorted(
+                    {str(value["topology"]) for value in values}
+                ),
+                "pull_request_numbers": sorted(
+                    {
+                        int(value["pull_request_number"])
+                        for value in values
+                        if isinstance(value.get("pull_request_number"), int)
+                        and not isinstance(value.get("pull_request_number"), bool)
+                    }
+                ),
+                "source_record_ids": sorted(
+                    {str(value["source_record_id"]) for value in values}
+                ),
+                "possible_duplicate_candidate_ids": [],
+                "screening_status": "NOT_STARTED",
+                "experiment_accessed": False,
+                "treatment_results_consulted": False,
+            }
+        )
+    for candidate_ids in by_repository_repair.values():
+        for left_index, left in enumerate(sorted(set(candidate_ids))):
+            for right in sorted(set(candidate_ids))[left_index + 1 :]:
+                possible_pairs.add((left, right))
+    possible_by_candidate: dict[str, set[str]] = defaultdict(set)
+    for left, right in sorted(possible_pairs):
+        possible_by_candidate[left].add(right)
+        possible_by_candidate[right].add(left)
+    pool_by_id = {value["canonical_candidate_id"]: value for value in pool}
+    for candidate_id, related in possible_by_candidate.items():
+        pool_by_id[candidate_id]["possible_duplicate_candidate_ids"] = sorted(related)
+        for occurrence in grouped[candidate_id]:
+            record = record_by_id[str(occurrence["source_record_id"])]
+            current = set(record.get("possible_duplicate_candidate_ids", []))
+            current.update(related)
+            record["possible_duplicate_candidate_ids"] = sorted(current)
+
+    record_index = {
+        record["source_record_id"]: record
+        for records in source_records.values()
+        for record in records
+    }
+    provenance: list[dict[str, Any]] = []
+    for candidate in sorted(pool, key=lambda item: item["canonical_candidate_id"]):
+        entries = []
+        for record_id in candidate["source_record_ids"]:
+            record = record_index[record_id]
+            entries.append(
+                {
+                    "source_record_id": record_id,
+                    "source_id": record["source_id"],
+                    "source_native_identity": record["source_native_identity"],
+                    "raw_artifact_sha256": sorted(
+                        artifact["sha256"] for artifact in record["raw_artifacts"]
+                    ),
+                }
+            )
+        provenance.append(
+            {
+                "canonical_candidate_id": candidate["canonical_candidate_id"],
+                "provenance": sorted(entries, key=lambda item: item["source_record_id"]),
+            }
+        )
+    return (
+        sorted(pool, key=lambda item: item["canonical_candidate_id"]),
+        provenance,
+        exact_duplicates,
+        [
+            {"left_candidate_id": left, "right_candidate_id": right}
+            for left, right in sorted(possible_pairs)
+        ],
+    )
+
+
+def _jsonl_bytes(values: Iterable[Mapping[str, Any]]) -> bytes:
+    return b"".join(canonical_document_bytes(value) + b"\n" for value in values)
+
+
+def _rejection_counts(records: Iterable[Mapping[str, Any]]) -> dict[str, int]:
+    counts: Counter[str] = Counter()
+    for record in records:
+        for code in record.get("rejection_reason_codes", []):
+            counts[str(code)] += 1
+    return dict(sorted(counts.items()))
+
