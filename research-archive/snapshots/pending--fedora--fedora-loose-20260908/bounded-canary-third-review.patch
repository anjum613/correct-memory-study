+                    "owner": {"login": "o"},
+                    "name": repository,
+                    "html_url": f"https://github.com/o/{repository}",
+                    "visibility": "public",
+                },
+            )
+        if re.fullmatch(r"/repos/o/r[0-9]+/pulls/[0-9]+", path):
+            return _response(200, {})
+        raise AssertionError(f"unexpected transport: {url}")
+
+    run_root = tmp_path / name
