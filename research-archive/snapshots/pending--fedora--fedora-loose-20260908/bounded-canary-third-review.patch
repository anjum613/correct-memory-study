+@contextmanager
+def _catchable_source_signal_boundary():
+    """Translate main-thread SIGINT/SIGTERM into terminal source failure."""
+
+    if threading.current_thread() is not threading.main_thread():
+        yield
+        return
+    candidates = (
+        getattr(signal, "SIGINT", None),
+        getattr(signal, "SIGTERM", None),
+    )
+    catchable = tuple(candidate for candidate in candidates if candidate is not None)
+    previous = {candidate: signal.getsignal(candidate) for candidate in catchable}
+
+    def interrupt(_signum: int, _frame: Any) -> None:
+        for candidate in catchable:
+            signal.signal(candidate, signal.SIG_IGN)
+        raise KeyboardInterrupt("catchable discovery termination signal")
+
+    try:
+        for candidate in catchable:
+            signal.signal(candidate, interrupt)
+        yield
+    finally:
+        for candidate, handler in previous.items():
+            signal.signal(candidate, handler)
+
