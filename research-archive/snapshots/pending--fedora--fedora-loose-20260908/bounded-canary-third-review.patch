+def materialize_searches(
+    *,
+    source_root: Path,
+    manifest: Mapping[str, Any],
+    capture_digest: str,
+    index: Mapping[str, Any],
+    search_spec: Mapping[str, Any],
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+    """Materialize direct PRs and issue-resolved merged PRs from raw capture."""
+
+    del manifest
+    captured = CapturedGitHubEvidence(source_root=source_root, index=index)
+    revision = {"kind": "VERSIONED_API_CAPTURE", "value": capture_digest}
+    query_list = search_spec.get("queries")
+    if not isinstance(query_list, list):
+        raise DiscoveryExecutionError("RAW_CAPTURE_INCOMPLETE", "queries missing")
+    queries = {
+        query["query_id"]: query
+        for query in query_list
+        if isinstance(query, Mapping) and isinstance(query.get("query_id"), str)
+    }
+    records: list[dict[str, Any]] = []
+    occurrences: list[dict[str, Any]] = []
+    for raw_object in index["source_objects"]:
+        source_object = _mapping(raw_object, "search source object")
+        native = _mapping(source_object.get("source_native_identity"), "native identity")
+        artifacts: list[dict[str, Any]] = []
+        rejection: list[str] = []
+        episodes: list[tuple[Any, dict[str, Any], int, dict[str, Any]]] = []
+        try:
+            item = _captured_search_item(captured, source_object, artifacts)
+            query = queries.get(source_object.get("query_id"))
+            if not isinstance(query, Mapping):
+                raise SourceRecordRejected("SOURCE_SCHEMA_DRIFT", "query ID missing")
+            owner, repository = _repository_coordinates_from_api_url(
+                item.get("repository_url")
+            )
+            number = _positive_int(item.get("number"), "search item number")
+            if query.get("object_type") == "PULL_REQUEST":
+                if not isinstance(item.get("pull_request"), Mapping):
+                    raise SourceRecordRejected(
+                        "GITHUB_PR_DETAIL_INCOMPLETE", "direct PR marker is missing"
+                    )
+                episode, repository_value, metadata = _captured_pr_episode(
+                    captured,
+                    owner=owner,
+                    repository=repository,
+                    number=number,
+                    artifacts=artifacts,
+                )
+                episodes.append((episode, repository_value, number, dict(metadata)))
+            elif query.get("object_type") == "ISSUE":
+                issue_repository_id, nodes = _captured_issue_nodes(
+                    captured,
+                    owner=owner,
+                    repository=repository,
+                    number=number,
+                    artifacts=artifacts,
+                )
+                _captured_repository(
+                    captured,
+                    owner=owner,
+                    repository=repository,
+                    artifacts=artifacts,
+                    expected_id=issue_repository_id,
+                )
+                for node in nodes:
+                    repository_node = node.get("repository")
+                    name_with_owner = (
+                        repository_node.get("nameWithOwner")
+                        if isinstance(repository_node, Mapping)
+                        else None
+                    )
+                    if not isinstance(name_with_owner, str) or name_with_owner.count("/") != 1:
+                        raise SourceRecordRejected(
+                            "GITHUB_ISSUE_RELATION_INCOMPLETE",
+                            "linked PR repository name is missing",
+                        )
+                    pr_owner, pr_repository = name_with_owner.split("/", 1)
+                    raw_pr_number = node.get("number")
+                    if (
+                        isinstance(raw_pr_number, bool)
+                        or not isinstance(raw_pr_number, int)
+                        or raw_pr_number <= 0
+                    ):
+                        raise SourceRecordRejected(
+                            "GITHUB_ISSUE_RELATION_INCOMPLETE",
+                            "linked PR number is missing",
+                        )
+                    expected_repository_id = repository_node.get("databaseId")
+                    if (
+                        isinstance(expected_repository_id, bool)
+                        or not isinstance(expected_repository_id, int)
+                        or expected_repository_id <= 0
+                    ):
+                        raise SourceRecordRejected(
+                            "GITHUB_REPOSITORY_ID_MISSING",
+                            "linked PR repository ID is missing",
+                        )
+                    episode, repository_value, metadata = _captured_pr_episode(
+                        captured,
+                        owner=pr_owner,
+                        repository=pr_repository,
+                        number=raw_pr_number,
+                        artifacts=artifacts,
+                        expected_repository_id=expected_repository_id,
+                    )
+                    _validate_graphql_pr_node(node, pr_metadata=metadata)
+                    episodes.append(
+                        (episode, repository_value, raw_pr_number, dict(metadata))
+                    )
+            else:
+                raise SourceRecordRejected("SOURCE_SCHEMA_DRIFT", "object_type invalid")
+        except SourceRecordRejected as error:
+            rejection.append(error.code)
+            episodes.clear()
+        except DiscoveryExecutionError as error:
+            if error.code in {
+                "SOURCE_SCHEMA_DRIFT",
+                "GITHUB_SEARCH_RESPONSE_MALFORMED",
+            }:
+                rejection.append(error.code)
+                episodes.clear()
+            else:
+                raise
+        unique: dict[str, tuple[Any, dict[str, Any], int, dict[str, Any]]] = {}
+        for value in episodes:
+            candidate_id = value[0].canonical_candidate_id
+            existing = unique.get(candidate_id)
+            if existing is not None and existing[2] != value[2]:
+                # Same exact range via multiple PRs remains one candidate with all
+                # source provenance; the first numeric PR is presentation-only.
+                if value[2] < existing[2]:
+                    unique[candidate_id] = value
+            else:
+                unique[candidate_id] = value
+        links = [
+            _candidate_link(value[0], pull_request_number=value[2])
+            for _, value in sorted(unique.items())
+        ]
+        record = _source_record(
+            source_id_value=SEARCH_SOURCE_ID,
+            source_revision_value=revision,
+            native_identity=native,
+            artifacts=artifacts,
+            candidate_links=links,
+            rejection_codes=rejection,
+        )
+        records.append(record)
+        if record["disposition"] == "MATERIALIZED":
+            for candidate_id, value in sorted(unique.items()):
+                episode, repository_value, pr_number, metadata = value
+                occurrences.append(
+                    _candidate_occurrence(
+                        episode=episode,
+                        source_record_id_value=record["source_record_id"],
+                        source_id_value=SEARCH_SOURCE_ID,
+                        repository=repository_value,
+                        topology=episode.topology,
+                        pull_request_number=pr_number,
+                        source_metadata={
+                            "query_id": source_object["query_id"],
+                            "observed_query_ids": source_object.get(
+                                "observed_query_ids", [source_object["query_id"]]
+                            ),
+                            "observed_leaf_provenance": source_object.get(
+                                "observed_leaf_provenance", []
+                            ),
+                            "github_search_node_id": source_object["node_id"],
+                            "pull_request": metadata,
+                        },
+                    )
+                )
+    return records, occurrences
