+def _readless_canary_artifact_check(
+    root: Path, descriptor: Mapping[str, Any]
+) -> Path:
+    """Apply the raw descriptor and lstat checks without reading its payload."""
+
+    path_value = descriptor.get("path")
+    digest = descriptor.get("sha256")
+    size_bytes = descriptor.get("size_bytes")
+    media_type = descriptor.get("media_type")
+    if (
+        set(descriptor) != {"path", "sha256", "size_bytes", "media_type"}
+        or not isinstance(path_value, str)
+        or not isinstance(digest, str)
+        or SHA256_PATTERN.fullmatch(digest) is None
+        or not isinstance(media_type, str)
+        or not media_type
+    ):
+        raise DiscoveryExecutionError(
+            "CANARY_ARTIFACT_INCOMPLETE", "canary artifact descriptor is malformed"
+        )
+    match = CANARY_RAW_ARTIFACT_PATH_PATTERN.fullmatch(path_value)
+    if match is None or "".join(match.groups()) != digest:
+        raise DiscoveryExecutionError(
+            "CANARY_ARTIFACT_PATH_UNSAFE",
+            "canary raw artifact path is not content addressed",
+        )
+    return _canary_regular_file(
+        root,
+        path_value,
+        maximum_size_bytes=CANARY_MAXIMUM_RAW_ARTIFACT_SIZE_BYTES,
+        declared_size_bytes=size_bytes,
