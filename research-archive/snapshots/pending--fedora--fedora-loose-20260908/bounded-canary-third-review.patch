+def _validate_lexical_canary_run_path(run_path: Path) -> None:
+    """Reject a symlink in any existing user-supplied path component."""
+
+    if run_path.is_absolute():
+        current = Path(run_path.anchor)
+        parts = run_path.parts[1:]
+    else:
+        current = Path.cwd()
+        parts = run_path.parts
+    for index, part in enumerate(parts):
+        current = current / part
+        try:
+            component_status = current.lstat()
+        except FileNotFoundError:
+            # A later lexical component cannot exist through a missing ancestor.
+            return
+        except OSError as error:
+            raise DiscoveryExecutionError(
+                "CANARY_RUN_PATH_UNSAFE",
+                "canary run path could not be inspected safely",
+            ) from error
+        if stat.S_ISLNK(component_status.st_mode):
+            raise DiscoveryExecutionError(
+                "CANARY_RUN_PATH_UNSAFE",
+                "canary run path contains a symbolic link",
+            )
+        if index != len(parts) - 1 and not stat.S_ISDIR(
+            component_status.st_mode
+        ):
+            raise DiscoveryExecutionError(
+                "CANARY_RUN_PATH_UNSAFE",
+                "canary run path has a non-directory ancestor",
+            )
+
+
+def _safe_timeout_executable() -> str:
+    """Return the one authoritative timeout binary, failing closed otherwise."""
+
+    try:
+        timeout_status = _TIMEOUT_EXECUTABLE.lstat()
+        is_exact_path = _TIMEOUT_EXECUTABLE.resolve(strict=True) == (
+            _TIMEOUT_EXECUTABLE
+        )
+    except OSError as error:
+        raise DiscoveryExecutionError(
+            "CANARY_TIMEOUT_LAUNCHER_UNSAFE",
+            "the authoritative OS timeout executable is unavailable",
+        ) from error
+    if (
+        not is_exact_path
+        or not stat.S_ISREG(timeout_status.st_mode)
+        or timeout_status.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
+        or not os.access(_TIMEOUT_EXECUTABLE, os.X_OK)
+    ):
+        raise DiscoveryExecutionError(
+            "CANARY_TIMEOUT_LAUNCHER_UNSAFE",
+            "the authoritative OS timeout executable is unsafe",
+        )
+    return str(_TIMEOUT_EXECUTABLE)
+
+
+def _run_with_authoritative_timeout(
+    worker_argv: Sequence[str],
+    *,
+    environment: dict[str, str] | None = None,
+    term_after_seconds: float = CANARY_TIMEOUT_TERM_SECONDS,
+    kill_after_seconds: float = CANARY_TIMEOUT_KILL_AFTER_SECONDS,
+) -> int:
+    """Run a private worker under TERM then KILL, without invoking a shell."""
+
+    if (
+        term_after_seconds <= 0
+        or kill_after_seconds <= 0
+        or term_after_seconds + kill_after_seconds > 2100
+    ):
+        raise DiscoveryExecutionError(
+            "CANARY_TIMEOUT_LAUNCHER_UNSAFE",
+            "the authoritative timeout interval is invalid",
+        )
+    command = [
+        _safe_timeout_executable(),
+        "--signal=TERM",
+        f"--kill-after={kill_after_seconds:g}s",
+        f"{term_after_seconds:g}s",
+        *worker_argv,
+    ]
+    completed = subprocess.run(  # noqa: S603 - exact argv, no shell
+        command,
+        env=environment,
+        shell=False,
+        check=False,
+    )
+    return completed.returncode
+
+
+def _launch_canary_worker(arguments: argparse.Namespace) -> int:
+    if os.environ.get(_INTERNAL_LAUNCHER_MARKER_ENV):
+        raise DiscoveryExecutionError(
+            "CANARY_RECURSIVE_LAUNCH_REJECTED",
+            "the public canary launcher cannot be recursively invoked",
+        )
+    marker = secrets.token_hex(32)
+    environment = os.environ.copy()
+    environment[_INTERNAL_LAUNCHER_MARKER_ENV] = marker
+    worker_argv = [
+        str(Path(sys.executable).absolute()),
+        str(Path(__file__).resolve()),
+        _INTERNAL_CANARY_WORKER,
+        "--run-directory",
+        str(arguments.run_directory),
+        "--token-file",
+        str(arguments.token_file),
+        "--query-id",
+        str(arguments.query_id),
+        "--internal-launcher-marker",
+        marker,
+    ]
+    return _run_with_authoritative_timeout(
+        worker_argv,
+        environment=environment,
+    )
+
