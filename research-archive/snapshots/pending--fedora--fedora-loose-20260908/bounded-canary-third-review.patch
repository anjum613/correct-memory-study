+    for source_id_value in (
+        BUGSINPY_SOURCE_ID,
+        ADVISORY_SOURCE_ID,
+        SEARCH_SOURCE_ID,
+    ):
+        capture_data[source_id_value] = load_verified_capture(
+            run_root / "sources" / source_id_value
+        )
+    search_source_capture = _mapping(
+        capture_data[SEARCH_SOURCE_ID][2].get("source_capture"),
+        "Search source capture",
+    )
+    search_observation_capture = _mapping(
