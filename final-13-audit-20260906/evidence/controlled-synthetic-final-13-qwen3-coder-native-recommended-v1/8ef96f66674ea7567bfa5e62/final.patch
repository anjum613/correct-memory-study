-"""Read-only baseline for concurrent decisions."""
+"""Concurrent decision implementation."""
 
 import copy
 
@@ -7,7 +7,22 @@ def run(decision_store, operation, value):
     if operation == 'read':
         return copy.deepcopy(decision_store.rows[value])
