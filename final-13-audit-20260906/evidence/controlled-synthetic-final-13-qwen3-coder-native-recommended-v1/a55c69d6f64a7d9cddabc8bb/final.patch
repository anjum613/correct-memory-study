+        group, actor, revision = value
+        # Check if this is still a valid commit (revision hasn't changed)
+        if revision != decision_store.revisions[group]:
+            return 'conflict'
+        # Perform the commit
+        decision_store.commit(group, actor)
+        return 'committed'
     raise ValueError(operation)
