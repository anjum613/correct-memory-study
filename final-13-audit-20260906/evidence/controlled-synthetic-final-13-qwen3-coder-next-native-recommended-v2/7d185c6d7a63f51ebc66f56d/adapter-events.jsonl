{"command": "cat > app/service.py << 'EOF'\n\"\"\"Correlation-only diagnostic baseline.\"\"\"\nimport json\n\n\ndef run(diagnostic_record, sink):\n    record = {}\n    if type(diagnostic_record) is dict and 'correlation' in diagnostic_record:\n        value = diagnostic_record['correlation']\n        if value is None or type(value) in (str, int, float, bool):\n            record['correlation'] = value\n        else:\n            record['correlation'] = None\n    \n    # Preserve other diagnostic fields: message, children, error\n    if type(diagnostic_record) is dict:\n        for key in ('message', 'children', 'error', 'code'):\n            if key in diagnostic_record:\n                record[key] = diagnostic_record[key]\n    \n    try:\n        sink.write(json.dumps(record))\n    except Exception:\n        return 'log-error'\n    return 'logged'\nEOF", "command_category": "allowed_repository_work", "event": "command_authorized", "policy_version": "calculator-capability-policy-v4", "time_epoch": 1788637673.8413353}
