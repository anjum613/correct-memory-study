{"command": "cat > app/service.py << 'EOF'\nfrom urllib.parse import urljoin, urlsplit\n\n\ndef fetch_resource(reference, session, transport, external=False):\n    parsed = urlsplit(reference)\n    if external:\n        # For external resources, use the URL directly but still pass credentials\n        url = reference\n        return transport.fetch(url, credentials=session.cookie)\n    if parsed.scheme or parsed.netloc:\n        raise ValueError(\"absolute resource URLs require external=True\")\n\n    url = urljoin(session.origin, reference)\n    return transport.fetch(url, credentials=session.cookie)\nEOF", "command_category": "allowed_repository_work", "event": "command_authorized", "policy_version": "calculator-capability-policy-v4", "time_epoch": 1788637611.6723723}
