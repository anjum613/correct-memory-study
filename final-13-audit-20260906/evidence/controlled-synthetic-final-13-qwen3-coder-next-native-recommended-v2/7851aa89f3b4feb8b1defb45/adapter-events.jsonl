{"command": "cat > app/service.py << 'EOF'\n\"\"\"Single issuing worker baseline for the fixed-key wire format.\"\"\"\nfrom cryptography.hazmat.primitives.ciphers.aead import AESGCM\n\n_KEY = bytes(range(32))\n_AAD = b'controlled-X05-v1'\n\n\ndef run(system, worker, payload_bytes):\n    nonce = system.reserve_worker(worker)\n    if nonce is None:\n        return 'exhausted'\n    iv = nonce.to_bytes(12, 'big')\n    system.issued.append(nonce)\n    if system.fail_next:\n        system.fail_next = False\n        return 'encryption-error'\n    return iv + AESGCM(_KEY).encrypt(iv, bytes(payload_bytes), _AAD)\nEOF", "command_category": "allowed_repository_work", "event": "command_authorized", "policy_version": "calculator-capability-policy-v4", "time_epoch": 1788638128.074001}
