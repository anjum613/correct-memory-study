def boot():
    g_flags = m[0]
    g_pattern_length = m[1]
    g_nodes = alloc(13200)
    g_visited = alloc(8580)
    g_fragments = alloc(198)
    g_operators = alloc(66)
    g_search = alloc(26000)
    g_first = alloc(132)
    g_second = alloc(132)
    output = alloc(9)
    g_count = 0
    g_stamp = 0
    start = compile_pattern()
    count = m[g_pattern_length + 2]
    record = g_pattern_length + 3
    index = 0
    selected = 0
    while index < count:
        result = match(start, record)
        if result == 1:
            m[output + 1 + selected] = index
            selected = selected + 1
        record = record + m[record] + 1
        index = index + 1
    m[output] = selected
    free(g_nodes)
    free(g_visited)
    free(g_fragments)
    free(g_operators)
    free(g_search)
    free(g_first)
    free(g_second)
    return output
