+def match_character_class(start, after, rec_base, rec_start, rec_end, ignore):
+    if rec_end != rec_start + 1:
+        return 0
+    if rec_start >= rec_end:
+        return 0
+    candidate = m[rec_base + rec_start]
+    position = start + 1
+    end = after - 1
+    complement = 0
+    if m[position] == 94:
+        complement = 1
+        position = position + 1
+    matched = 0
+    while position < end:
+        first = m[position]
+        after_first = position + 1
+        if first == 92:
+            first = m[after_first]
+            after_first = after_first + 1
+        if after_first < end and m[after_first] == 45:
+            range_end = after_first + 1
+            second = m[range_end]
+            after_second = range_end + 1
+            if second == 92:
+                second = m[after_second]
+                after_second = after_second + 1
+            if first <= second:
+                if in_range_with_ignore(candidate, first, second, ignore) == 1:
+                    matched = 1
+            position = after_second
+        else:
+            if byte_eq_with_ignore(candidate, first, ignore) == 1:
+                matched = 1
+            position = after_first
+    if complement == 1:
+        if matched == 1:
+            return 0
+        return 1
+    return matched
+
+
+def match_atom(start, after, rec_base, rec_start, rec_end, ignore):
+    if rec_start > rec_end:
+        return 0
+    character = m[start]
+    if character == 46:
+        if rec_end != rec_start + 1:
+            return 0
+        return 1
+    if character == 92:
+        if rec_end != rec_start + 1:
+            return 0
+        expected = m[start + 1]
+        candidate = m[rec_base + rec_start]
+        return byte_eq_with_ignore(candidate, expected, ignore)
+    if character == 91:
+        return match_character_class(start, after, rec_base, rec_start, rec_end, ignore)
+    if character == 40:
+        return match_expression(start + 1, after - 1, rec_base, rec_start, rec_end, ignore)
+    if rec_end != rec_start + 1:
+        return 0
+    candidate = m[rec_base + rec_start]
+    return byte_eq_with_ignore(candidate, character, ignore)
+
