+def is_upper(value):
+    if value >= 65:
+        if value <= 90:
+            return 1
+    return 0
+
+
+def is_lower(value):
+    if value >= 97:
+        if value <= 122:
+            return 1
+    return 0
+
+
+def byte_eq_with_ignore(candidate, target, ignore):
+    if target == candidate:
+        return 1
+    if ignore == 0:
+        return 0
+    if is_upper(candidate) == 1:
+        if target == candidate + 32:
+            return 1
+    if is_lower(candidate) == 1:
+        if target == candidate - 32:
+            return 1
+    return 0
+
+
+def in_range_with_ignore(candidate, first, last, ignore):
+    if first <= candidate:
+        if candidate <= last:
+            return 1
+    if ignore == 0:
+        return 0
+    if is_upper(candidate) == 1:
+        candidate = candidate + 32
+        if first <= candidate:
+            if candidate <= last:
+                return 1
+    elif is_lower(candidate) == 1:
+        candidate = candidate - 32
+        if first <= candidate:
+            if candidate <= last:
+                return 1
+    return 0
+
