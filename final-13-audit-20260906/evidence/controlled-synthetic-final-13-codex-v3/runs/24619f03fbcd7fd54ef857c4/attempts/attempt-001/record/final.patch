+def match_star_tail(atom_start, after, rec_base, rec_pos, rec_end, stop, ignore):
+    if match_sequence(after, stop, rec_base, rec_pos, rec_end, ignore) >= 0:
+        return 1
+    if rec_pos == rec_end:
+        return 0
+    candidate = rec_pos + 1
+    while candidate <= rec_end:
+        if match_atom(atom_start, after, rec_base, rec_pos, candidate, ignore) == 1:
+            if match_star_tail(atom_start, after, rec_base, candidate, rec_end, stop, ignore) == 1:
+                return 1
+        candidate = candidate + 1
+    return 0
+
+
+def match_repetition(atom_start, after, quant, rec_base, rec_start, rec_end, stop, ignore):
+    if quant == 0:
+        candidate = rec_start
+        while candidate <= rec_end:
+            if match_atom(atom_start, after, rec_base, rec_start, candidate, ignore) == 1:
+                if match_sequence(after, stop, rec_base, candidate, rec_end, ignore) >= 0:
+                    return 1
+            candidate = candidate + 1
+        return 0
+    if quant == 63:
+        if match_sequence(after, stop, rec_base, rec_start, rec_end, ignore) >= 0:
+            return 1
+        candidate = rec_start
+        while candidate <= rec_end:
+            if match_atom(atom_start, after, rec_base, rec_start, candidate, ignore) == 1:
+                if match_sequence(after, stop, rec_base, candidate, rec_end, ignore) >= 0:
+                    return 1
+            candidate = candidate + 1
+        return 0
+    if quant == 42:
+        if match_sequence(after, stop, rec_base, rec_start, rec_end, ignore) >= 0:
+            return 1
+        candidate = rec_start + 1
+        while candidate <= rec_end:
+            if match_atom(atom_start, after, rec_base, rec_start, candidate, ignore) == 1:
+                if match_star_tail(atom_start, after, rec_base, candidate, rec_end, stop, ignore) == 1:
+                    return 1
+            candidate = candidate + 1
+        return 0
+    candidate = rec_start
+    while candidate <= rec_end:
+        if match_atom(atom_start, after, rec_base, rec_start, candidate, ignore) == 1:
+            if candidate == rec_start:
+                if match_sequence(after, stop, rec_base, rec_start, rec_end, ignore) >= 0:
+                    return 1
+            else:
+                if match_star_tail(atom_start, after, rec_base, candidate, rec_end, stop, ignore) == 1:
+                    return 1
+        candidate = candidate + 1
+    return 0
