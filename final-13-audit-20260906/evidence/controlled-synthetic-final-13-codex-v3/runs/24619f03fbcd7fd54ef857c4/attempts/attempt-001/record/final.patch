+def find_matching_paren(open_position, stop):
+    depth = 1
+    position = open_position + 1
+    in_class = 0
+    while position < stop:
+        if in_class == 1:
+            character = m[position]
+            if character == 92:
+                position = position + 1
+            elif character == 93:
+                in_class = 0
+            position = position + 1
+        else:
+            character = m[position]
+            if character == 91:
+                in_class = 1
+            elif character == 40:
+                depth = depth + 1
+            elif character == 41:
+                depth = depth - 1
+                if depth == 0:
+                    return position + 1
+            elif character == 92:
+                position = position + 1
+            position = position + 1
+    return stop
+
+
+def find_matching_class(open_position, stop):
+    position = open_position + 1
+    while position < stop:
+        character = m[position]
+        if character == 92:
+            position = position + 1
+            if position >= stop:
+                return stop
+            position = position + 1
+        elif character == 93:
+            return position + 1
+        else:
+            position = position + 1
+    return stop
+
+
+def parse_atom_end(position, stop):
+    character = m[position]
+    if character == 40:
+        return find_matching_paren(position, stop)
+    if character == 91:
+        return find_matching_class(position, stop)
+    if character == 92:
+        return position + 2
+    return position + 1
+
