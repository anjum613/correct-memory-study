+def match_expression(start, stop, rec_base, rec_start, rec_end, ignore):
+    position = start
+    while 1:
+        sequence_result = match_sequence(position, stop, rec_base, rec_start, rec_end, ignore)
+        if sequence_result >= 0:
+            return 1
+        position = (-sequence_result) - 1
+        if position >= stop:
+            return 0
+        if m[position] != 124:
+            return 0
+        position = position + 1
+
+
+def match_sequence(position, stop, rec_base, rec_start, rec_end, ignore):
+    success = 1
+    has_atom = 0
+    while position < stop:
+        if m[position] == 124:
+            break
+        atom_start = position
+        atom_end = parse_atom_end(position, stop)
+        position = atom_end
+        quant = 0
+        if position < stop:
+            marker = m[position]
+            if marker == 42 or marker == 43 or marker == 63:
+                quant = marker
+                position = position + 1
+        if success == 1:
+            if match_repetition(atom_start, position, quant, rec_base, rec_start, rec_end, stop, ignore) == 0:
+                success = 0
+        has_atom = 1
+    if success == 1 and has_atom == 0:
+        if rec_start != rec_end:
+            success = 0
+    if success == 1:
+        return position
+    return -position - 1
+
