+            elif reserved_class(last):
+                g_bad = 1
+                return 0
+            if last < first:
+                g_bad = 1
+                return 0
+            if first <= c and c <= last:
+                hit = 1
+            if g_flags == 1:
+                if 65 <= c and c <= 90:
