+def find_class_end(i):
+    i = i + 1
+    if i < g_plen and pat(i) == 94:
+        i = i + 1
+    seen = 0
+    while i < g_plen and pat(i) != 93:
+        seen = 1
+        if pat(i) == 92:
+            i = i + 1
+            if i >= g_plen:
+                g_bad = 1
