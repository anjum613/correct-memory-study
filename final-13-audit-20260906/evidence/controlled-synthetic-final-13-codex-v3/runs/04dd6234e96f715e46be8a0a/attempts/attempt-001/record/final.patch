+def _new_patch(address, patch_base, patch_count_addr):
+    patch_count = m[patch_count_addr]
+    patch = patch_base + patch_count * 2
+    m[patch_count_addr] = patch_count + 1
+    m[patch] = address
+    m[patch + 1] = 0
+    return patch
+
