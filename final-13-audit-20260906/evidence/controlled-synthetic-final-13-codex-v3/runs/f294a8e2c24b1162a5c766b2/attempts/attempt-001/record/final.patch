+def fail():
+    o = alloc(1)
+    m[o] = 9
+    m[o + 1] = 0
+    return o
+
+def is_letter(c):
+    return (65 <= c and c <= 90) or (97 <= c and c <= 122)
+
+def lower(c):
+    if 65 <= c and c <= 90:
+        return c + 32
+    return c
+
+def upper(c):
+    if 97 <= c and c <= 122:
+        return c - 32
+    return c
+
+def is_reserved(c):
+    return c == 46 or c == 91 or c == 93 or c == 40 or c == 41 or c == 124 or c == 42 or c == 43 or c == 63 or c == 92 or c == 94 or c == 36 or c == 123 or c == 125
+
+def is_class_reserved(c):
+    return c == 91 or c == 93 or c == 92 or c == 45 or c == 94
+
+def clear_set(b):
+    i = 0
+    while i < 65:
+        m[b + i] = 0
+        i = i + 1
+    return 0
+
+def copy_set(dst, src):
+    i = 0
+    while i < 65:
+        m[dst + i] = m[src + i]
+        i = i + 1
+    return 0
+
+def union_set(dst, src):
+    ch = 0
+    i = 0
+    while i < 65:
+        if m[src + i] != 0 and m[dst + i] == 0:
+            m[dst + i] = 1
+            ch = 1
+        i = i + 1
+    return ch
+
+def add_member(node, c):
+    if c < 32 or 126 < c:
+        return 1
+    m[g_sets + node * 95 + c - 32] = 1
+    if m[g_flag] != 0 and is_letter(c):
+        m[g_sets + node * 95 + lower(c) - 32] = 1
+        m[g_sets + node * 95 + upper(c) - 32] = 1
+    return 0
+
+def new_node(t, a, b):
+    n = m[g_nodes]
+    if n >= 192:
+        return -1
+    m[g_nodes] = n + 1
+    m[g_type + n] = t
+    m[g_left + n] = a
+    m[g_right + n] = b
+    i = 0
+    while i < 95:
+        m[g_sets + n * 95 + i] = 0
+        i = i + 1
+    return n
+
+def peek():
+    if m[g_pos] >= m[g_plen]:
+        return -1
+    return m[2 + m[g_pos]]
+
+def take_char(in_class):
+    c = peek()
+    if c < 0:
+        return -1
+    m[g_pos] = m[g_pos] + 1
+    if c == 92:
+        c = peek()
+        if c < 0:
+            return -1
+        if in_class != 0:
+            if not is_class_reserved(c):
+                return -1
+        else:
+            if not is_reserved(c):
+                return -1
+        m[g_pos] = m[g_pos] + 1
+        return c
+    if in_class != 0:
+        if is_class_reserved(c):
+            return -1
+    else:
+        if is_reserved(c):
+            return -1
+    return c
+
+def save_parse():
