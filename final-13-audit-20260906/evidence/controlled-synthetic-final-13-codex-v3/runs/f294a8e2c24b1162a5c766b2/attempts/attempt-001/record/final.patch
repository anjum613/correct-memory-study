+    m[b + 6] = g_p_x
+    m[b + 7] = g_p_left
+    m[b + 8] = g_p_made
+    m[b + 9] = g_p_right
+    m[b + 10] = g_p_result
+    m[b + 11] = g_expr_left
+    m[g_psp] = m[g_psp] + 1
+    return 0
+
+def restore_parse():
+    m[g_psp] = m[g_psp] - 1
+    b = g_pstack + m[g_psp] * 12
+    g_p_c = m[b]
+    g_p_n = m[b + 1]
+    g_p_comp = m[b + 2]
+    g_p_count = m[b + 3]
+    g_p_first = m[b + 4]
+    g_p_last = m[b + 5]
+    g_p_x = m[b + 6]
+    g_p_left = m[b + 7]
+    g_p_made = m[b + 8]
+    g_p_right = m[b + 9]
+    g_p_result = m[b + 10]
+    g_expr_left = m[b + 11]
+    return 0
+
+def parse_atom():
+    g_p_c = peek()
+    if g_p_c < 0:
+        return -1
+    if g_p_c == 40:
+        m[g_pos] = m[g_pos] + 1
+        save_parse()
+        g_parse_result = parse_expression()
+        restore_parse()
+        g_p_n = g_parse_result
+        if g_p_n < 0 or peek() != 41:
+            return -1
+        m[g_pos] = m[g_pos] + 1
+        return g_p_n
+    if g_p_c == 46:
+        m[g_pos] = m[g_pos] + 1
+        g_p_n = new_node(1, 0, 0)
+        g_p_x = 0
+        while g_p_x < 95:
+            m[g_sets + g_p_n * 95 + g_p_x] = 1
+            g_p_x = g_p_x + 1
+        return g_p_n
+    if g_p_c == 91:
+        m[g_pos] = m[g_pos] + 1
+        g_p_comp = 0
+        if peek() == 94:
+            g_p_comp = 1
+            m[g_pos] = m[g_pos] + 1
+        g_p_n = new_node(1, 0, 0)
+        g_p_count = 0
+        while peek() >= 0 and peek() != 93:
+            g_p_first = take_char(1)
+            if g_p_first < 0:
+                return -1
+            if peek() == 45:
+                m[g_pos] = m[g_pos] + 1
+                g_p_last = take_char(1)
+                if g_p_last < g_p_first:
+                    return -1
+                g_p_x = g_p_first
+                while g_p_x <= g_p_last:
+                    add_member(g_p_n, g_p_x)
+                    g_p_count = g_p_count + 1
+                    g_p_x = g_p_x + 1
+            else:
+                add_member(g_p_n, g_p_first)
+                g_p_count = g_p_count + 1
+        if g_p_count == 0 or peek() != 93:
+            return -1
+        m[g_pos] = m[g_pos] + 1
+        if g_p_comp != 0:
+            g_p_x = 0
+            while g_p_x < 95:
+                m[g_sets + g_p_n * 95 + g_p_x] = not m[g_sets + g_p_n * 95 + g_p_x]
+                g_p_x = g_p_x + 1
+        return g_p_n
+    g_p_c = take_char(0)
+    if g_p_c < 0:
+        return -1
+    g_p_n = new_node(1, 0, 0)
+    add_member(g_p_n, g_p_c)
+    return g_p_n
+
+def parse_repetition():
+    g_p_n = parse_atom()
+    if g_p_n < 0:
+        return -1
+    g_p_c = peek()
+    if g_p_c == 42 or g_p_c == 43 or g_p_c == 63:
+        m[g_pos] = m[g_pos] + 1
+        if g_p_c == 42:
+            g_p_n = new_node(5, g_p_n, 0)
+        elif g_p_c == 43:
+            g_p_n = new_node(6, g_p_n, 0)
+        else:
+            g_p_n = new_node(4, g_p_n, 0)
+    return g_p_n
+
+def parse_sequence():
+    g_p_left = new_node(0, 0, 0)
+    g_p_made = 0
+    while peek() >= 0 and peek() != 41 and peek() != 124:
+        g_p_n = parse_repetition()
+        if g_p_n < 0:
+            return -1
+        if g_p_made == 0:
+            g_p_left = g_p_n
+            g_p_made = 1
+        else:
+            g_p_left = new_node(2, g_p_left, g_p_n)
+    return g_p_left
+
+def parse_expression():
+    g_expr_left = parse_sequence()
+    if g_expr_left < 0:
+        return -1
+    while peek() == 124:
+        m[g_pos] = m[g_pos] + 1
+        g_p_right = parse_sequence()
+        if g_p_right < 0:
+            return -1
+        g_expr_left = new_node(3, g_expr_left, g_p_right)
+    return g_expr_left
+
+def matches_char(node, c):
+    if c < 32 or 126 < c:
+        return 0
+    return m[g_sets + node * 95 + c - 32]
+
+def save_match():
