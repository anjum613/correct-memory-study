+        restore_match()
+        union_set(g_m_out, g_m_t1)
+    elif g_m_t == 4:
+        m[g_m_out + g_m_start] = 1
+        save_match()
+        match_node(m[g_left + g_m_node], g_m_start, g_m_rb, g_m_rl, g_m_t1, g_m_depth + 1)
+        restore_match()
+        union_set(g_m_out, g_m_t1)
+    elif g_m_t == 5:
+        m[g_m_out + g_m_start] = 1
+        clear_set(g_m_proc)
+        g_m_changed = 1
+        while g_m_changed != 0:
+            g_m_changed = 0
+            g_m_i = 0
+            while g_m_i <= g_m_rl:
+                if m[g_m_out + g_m_i] != 0 and m[g_m_proc + g_m_i] == 0:
