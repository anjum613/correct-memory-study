def is_alpha(c):
    return (65 <= c and c <= 90) or (97 <= c and c <= 122)

def lower(c):
    if 65 <= c and c <= 90:
        return c + 32
    return c

def char_eq(a, b):
    if g_flag == 1 and is_alpha(a) and is_alpha(b):
        return lower(a) == lower(b)
    return a == b

def is_reserved(c):
    return c == 46 or c == 91 or c == 93 or c == 40 or c == 41 or c == 124 or c == 42 or c == 43 or c == 63 or c == 92 or c == 94 or c == 36 or c == 123 or c == 125

def is_class_reserved(c):
    return c == 91 or c == 93 or c == 92 or c == 45 or c == 94

def clear_set(base):
    i = 0
    while i <= 64:
        m[base + i] = 0
        i = i + 1

def copy_set(dst, src):
    i = 0
    while i <= 64:
        m[dst + i] = m[src + i]
        i = i + 1

def or_set(dst, src):
    i = 0
    while i <= 64:
        if m[src + i] != 0:
            m[dst + i] = 1
        i = i + 1

def same_set(a, b):
    i = 0
    while i <= 64:
        if m[a + i] != m[b + i]:
            return 0
        i = i + 1
    return 1

def class_char(pos):
    if pos >= g_plen:
        g_valid = 0
        return 0
    c = m[2 + pos]
    if c == 92:
        pos = pos + 1
        if pos >= g_plen:
            g_valid = 0
            return 0
        c = m[2 + pos]
        if not is_class_reserved(c):
            g_valid = 0
    else:
        if is_class_reserved(c):
            g_valid = 0
    return c

def class_char_next(pos):
    if m[2 + pos] == 92:
        return pos + 2
    return pos + 1

def class_contains(lo, hi, ch):
    pos = lo + 1
    comp = 0
    hit = 0
    any = 0
    if pos < hi and m[2 + pos] == 94:
        comp = 1
        pos = pos + 1
    while pos < hi:
        first = class_char(pos)
        pos2 = class_char_next(pos)
        if pos2 < hi and m[2 + pos2] == 45:
            pos3 = pos2 + 1
            if pos3 >= hi:
                g_valid = 0
                return 0
            last = class_char(pos3)
            pos = class_char_next(pos3)
            if last < first:
                g_valid = 0
            if g_flag == 1 and is_alpha(ch):
                lc = lower(ch)
                if lower(first) <= lc and lc <= lower(last):
                    hit = 1
                if first <= ch and ch <= last:
                    hit = 1
            else:
                if first <= ch and ch <= last:
                    hit = 1
        else:
            pos = pos2
            if char_eq(ch, first):
                hit = 1
        any = 1
    if any == 0:
        g_valid = 0
    if comp != 0:
        return not hit
    return hit

def scan_atom_end(lo, hi):
    if lo >= hi:
        g_valid = 0
        return lo
    c = m[2 + lo]
    if c == 40:
        depth = 1
        pos = lo + 1
        while pos < hi and depth != 0:
            d = m[2 + pos]
            if d == 92:
                pos = pos + 2
            else:
                if d == 91:
                    pos = scan_atom_end(pos, hi)
                else:
                    if d == 40:
                        depth = depth + 1
                    else:
                        if d == 41:
                            depth = depth - 1
                    pos = pos + 1
        if depth != 0:
            g_valid = 0
        return pos
    if c == 91:
        pos = lo + 1
        if pos < hi and m[2 + pos] == 94:
            pos = pos + 1
        any = 0
        while pos < hi and m[2 + pos] != 93:
            first = class_char(pos)
            pos = class_char_next(pos)
            if pos < hi and m[2 + pos] == 45:
                pos = pos + 1
                if pos >= hi:
                    g_valid = 0
                    return hi
                last = class_char(pos)
                if last < first:
                    g_valid = 0
                pos = class_char_next(pos)
            any = 1
        if pos >= hi or any == 0:
            g_valid = 0
            return hi
        return pos + 1
    if c == 46:
        return lo + 1
    if c == 92:
        if lo + 1 >= hi or not is_reserved(m[2 + lo + 1]):
            g_valid = 0
        return lo + 2
    if is_reserved(c):
        g_valid = 0
    return lo + 1

def split_alt(lo, hi):
    depth = 0
    pos = lo
    while pos < hi:
        c = m[2 + pos]
        if c == 92:
            pos = pos + 2
        else:
            if c == 91:
                pos = scan_atom_end(pos, hi)
            else:
                if c == 40:
                    depth = depth + 1
                else:
                    if c == 41:
                        if depth == 0:
                            g_valid = 0
                        depth = depth - 1
                    else:
                        if c == 124 and depth == 0:
                            return pos
                pos = pos + 1
    if depth != 0:
        g_valid = 0
    return hi

def match_atom(lo, hi, inbase, outbase, recbase, rlen):
    clear_set(outbase)
    c = m[2 + lo]
    if c == 40:
        eval_expr(lo + 1, hi - 1, inbase, outbase, recbase, rlen)
        return 0
    i = 0
    while i < rlen:
        if m[inbase + i] != 0:
            ch = m[recbase + i]
            ok = 0
            if c == 46:
                ok = 1
            else:
                if c == 91:
                    ok = class_contains(lo, hi - 1, ch)
                else:
                    lit = c
                    if c == 92:
                        lit = m[2 + lo + 1]
                    ok = char_eq(ch, lit)
            if ok != 0:
                m[outbase + i + 1] = 1
        i = i + 1
    return 0

def apply_piece(alo, ahi, quant, cur, nxt, tmp, recbase, rlen):
    base = g_sp
    m[g_frame + base] = alo
    m[g_frame + base + 1] = ahi
    m[g_frame + base + 2] = quant
    m[g_frame + base + 3] = cur
    m[g_frame + base + 4] = nxt
    m[g_frame + base + 5] = tmp
    m[g_frame + base + 6] = recbase
    m[g_frame + base + 7] = rlen
    g_sp = g_sp + 8
    match_atom(alo, ahi, cur, nxt, recbase, rlen)
    base = g_sp - 8
    alo = m[g_frame + base]
    ahi = m[g_frame + base + 1]
    quant = m[g_frame + base + 2]
    cur = m[g_frame + base + 3]
    nxt = m[g_frame + base + 4]
    tmp = m[g_frame + base + 5]
    recbase = m[g_frame + base + 6]
    rlen = m[g_frame + base + 7]
    if quant == 0:
        g_sp = base
        return 0
    if quant == 63:
        or_set(nxt, cur)
        g_sp = base
        return 0
    if quant == 43:
        copy_set(cur, nxt)
    clear_set(tmp)
    while same_set(tmp, cur) == 0:
        copy_set(tmp, cur)
        m[g_frame + base] = alo
        m[g_frame + base + 1] = ahi
        m[g_frame + base + 2] = quant
        m[g_frame + base + 3] = cur
        m[g_frame + base + 4] = nxt
        m[g_frame + base + 5] = tmp
        m[g_frame + base + 6] = recbase
        m[g_frame + base + 7] = rlen
        match_atom(alo, ahi, cur, nxt, recbase, rlen)
        base = g_sp - 8
        alo = m[g_frame + base]
        ahi = m[g_frame + base + 1]
        quant = m[g_frame + base + 2]
        cur = m[g_frame + base + 3]
        nxt = m[g_frame + base + 4]
        tmp = m[g_frame + base + 5]
        recbase = m[g_frame + base + 6]
        rlen = m[g_frame + base + 7]
        or_set(nxt, cur)
        or_set(nxt, tmp)
        copy_set(cur, nxt)
    copy_set(nxt, cur)
    g_sp = base
    return 0

def eval_seq(lo, hi, inbase, outbase, recbase, rlen):
    cur = alloc(65)
    nxt = alloc(65)
    tmp = alloc(65)
    copy_set(cur, inbase)
    pos = lo
    while pos < hi:
        ae = scan_atom_end(pos, hi)
        q = 0
        if ae < hi:
            qc = m[2 + ae]
            if qc == 42 or qc == 43 or qc == 63:
                q = qc
                ae = ae + 1
                if ae < hi:
                    nc = m[2 + ae]
                    if nc == 42 or nc == 43 or nc == 63:
                        g_valid = 0
        base = g_sp
        m[g_frame + base] = lo
        m[g_frame + base + 1] = hi
        m[g_frame + base + 2] = inbase
        m[g_frame + base + 3] = outbase
        m[g_frame + base + 4] = recbase
        m[g_frame + base + 5] = rlen
        m[g_frame + base + 6] = cur
        m[g_frame + base + 7] = nxt
        m[g_frame + base + 8] = tmp
        m[g_frame + base + 9] = pos
        m[g_frame + base + 10] = ae
        m[g_frame + base + 11] = q
        g_sp = g_sp + 12
        apply_piece(pos, ae - (q != 0), q, cur, nxt, tmp, recbase, rlen)
        base = g_sp - 12
        lo = m[g_frame + base]
        hi = m[g_frame + base + 1]
        inbase = m[g_frame + base + 2]
        outbase = m[g_frame + base + 3]
        recbase = m[g_frame + base + 4]
        rlen = m[g_frame + base + 5]
        cur = m[g_frame + base + 6]
        nxt = m[g_frame + base + 7]
        tmp = m[g_frame + base + 8]
        pos = m[g_frame + base + 9]
        ae = m[g_frame + base + 10]
        q = m[g_frame + base + 11]
        g_sp = base
        copy_set(cur, nxt)
        pos = ae
    copy_set(outbase, cur)
    free(tmp)
    free(nxt)
    free(cur)
    return 0

def eval_expr(lo, hi, inbase, outbase, recbase, rlen):
    clear_set(outbase)
    pos = lo
    tmp = alloc(65)
    while pos <= hi:
        bar = split_alt(pos, hi)
        base = g_sp
        m[g_frame + base] = lo
        m[g_frame + base + 1] = hi
        m[g_frame + base + 2] = inbase
        m[g_frame + base + 3] = outbase
        m[g_frame + base + 4] = recbase
        m[g_frame + base + 5] = rlen
        m[g_frame + base + 6] = pos
        m[g_frame + base + 7] = tmp
        m[g_frame + base + 8] = bar
        g_sp = g_sp + 9
        eval_seq(pos, bar, inbase, tmp, recbase, rlen)
        base = g_sp - 9
        lo = m[g_frame + base]
        hi = m[g_frame + base + 1]
        inbase = m[g_frame + base + 2]
        outbase = m[g_frame + base + 3]
        recbase = m[g_frame + base + 4]
        rlen = m[g_frame + base + 5]
        pos = m[g_frame + base + 6]
        tmp = m[g_frame + base + 7]
        bar = m[g_frame + base + 8]
        g_sp = base
        or_set(outbase, tmp)
        pos = bar + 1
        if bar == hi:
            pos = hi + 1
    free(tmp)
    return 0

def invalid_output():
    o = alloc(1)
    m[o] = 1
    return o

def boot():
    g_flag = m[0]
    g_plen = m[1]
    g_valid = 1
    g_sp = 0
    g_frame = alloc(4096)
    rcount_addr = 2 + g_plen
    rcount = m[rcount_addr]
    out = alloc(9)
    m[out] = 0
    recbase = rcount_addr + 1
    idx = 0
    in_set = alloc(65)
    res_set = alloc(65)
    while idx < rcount:
        rlen = m[recbase]
        clear_set(in_set)
        m[in_set] = 1
        eval_expr(0, g_plen, in_set, res_set, recbase + 1, rlen)
        if g_valid == 0:
            free(res_set)
            free(in_set)
            return invalid_output()
        if m[res_set + rlen] != 0:
            n = m[out]
            m[out + 1 + n] = idx
            m[out] = n + 1
        recbase = recbase + 1 + rlen
        idx = idx + 1
    if rcount == 0:
        clear_set(in_set)
        m[in_set] = 1
        eval_expr(0, g_plen, in_set, res_set, recbase, 0)
        if g_valid == 0:
            free(res_set)
            free(in_set)
            return invalid_output()
    free(res_set)
    free(in_set)
    return out
