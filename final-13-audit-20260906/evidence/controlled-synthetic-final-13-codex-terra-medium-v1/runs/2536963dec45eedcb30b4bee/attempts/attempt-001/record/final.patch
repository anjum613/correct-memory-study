--- a/app/service.csirpy
+++ b/app/service.csirpy
@@ -1,4 +1,306 @@
 def boot():
-    output = alloc(1)
-    m[output] = 0
-    return output
+    # Runtime Thompson-NFA matcher.  The input has been bounds-checked by the
+    # adapter; all temporary state lives in metered allocated regions.
+    pat = 2
+    plen = m[1]
+    flag = m[0]
+    # One state is (kind, edge1, edge2, charset).  This intentionally small
+    # recognizer covers literals, dot, classes, grouping and all operators.
+    st = alloc(1024)
+    cur = alloc(256)
+    nxt = alloc(256)
+    todo = alloc(256)
+    active = alloc(256)
+    out = alloc(9)
+    m[out] = 0
+    # A compact recursive-descent equivalent is represented by a position
+    # indexed dynamic-programming table.  entry [a,b] is whether the complete
+    # pattern prefix a can consume record prefix b; the parser below builds a
+    # Thompson machine in a postfix work region.
+    post = alloc(256)
+    op = alloc(128)
+    pc = 0
+    oc = 0
+    p = 0
+    need = 1
+    while p < plen:
+        c = m[pat + p]
+        if c == 124:
+            if need:
+                m[post + pc * 2] = 7
+                pc = pc + 1
+            while oc > 0 and m[op + oc - 1] == 2:
+                oc = oc - 1
+                m[post + pc * 2] = 2
+                pc = pc + 1
+            while oc > 0 and m[op + oc - 1] == 3:
+                oc = oc - 1
+                m[post + pc * 2] = 3
+                pc = pc + 1
+            m[op + oc] = 3
+            oc = oc + 1
+            p = p + 1
+            need = 1
+        else:
+            if c == 40:
+                if not need:
+                    m[op + oc] = 2
+                    oc = oc + 1
+                m[op + oc] = 8
+                oc = oc + 1
+                p = p + 1
+                need = 1
+            else:
+                if c == 41:
+                    if need:
+                        m[post + pc * 2] = 7
+                        pc = pc + 1
+                    while oc > 0 and m[op + oc - 1] != 8:
+                        oc = oc - 1
+                        m[post + pc * 2] = m[op + oc]
+                        pc = pc + 1
+                    oc = oc - 1
+                    p = p + 1
+                    need = 0
+                else:
+                    if c == 42 or c == 43 or c == 63:
+                        if c == 42:
+                            m[post + pc * 2] = 4
+                        else:
+                            if c == 43:
+                                m[post + pc * 2] = 5
+                            else:
+                                m[post + pc * 2] = 6
+                        pc = pc + 1
+                        p = p + 1
+                    else:
+                        if not need:
+                            m[op + oc] = 2
+                            oc = oc + 1
+                        base = alloc(95)
+                        x = 0
+                        while x < 95:
+                            m[base + x] = 0
+                            x = x + 1
+                        if c == 46:
+                            x = 0
+                            while x < 95:
+                                m[base + x] = 1
+                                x = x + 1
+                            p = p + 1
+                        else:
+                            if c == 91:
+                                p = p + 1
+                                inv = 0
+                                if m[pat + p] == 94:
+                                    inv = 1
+                                    p = p + 1
+                                done = 0
+                                while done == 0:
+                                    a = m[pat + p]
+                                    p = p + 1
+                                    if a == 93:
+                                        done = 1
+                                    else:
+                                        if a == 92:
+                                            a = m[pat + p]
+                                            p = p + 1
+                                        z = a
+                                        if m[pat + p] == 45:
+                                            p = p + 1
+                                            z = m[pat + p]
+                                            p = p + 1
+                                            if z == 92:
+                                                z = m[pat + p]
+                                                p = p + 1
+                                        while a <= z:
+                                            m[base + a - 32] = 1
+                                            a = a + 1
+                                if flag:
+                                    x = 0
+                                    while x < 26:
+                                        if m[base + x + 33]:
+                                            m[base + x + 65] = 1
+                                        if m[base + x + 65]:
+                                            m[base + x + 33] = 1
+                                        x = x + 1
+                                if inv:
+                                    x = 0
+                                    while x < 95:
+                                        m[base + x] = not m[base + x]
+                                        x = x + 1
+                            else:
+                                if c == 92:
+                                    p = p + 1
+                                    c = m[pat + p]
+                                p = p + 1
+                                m[base + c - 32] = 1
+                                if flag:
+                                    if c >= 65 and c <= 90:
+                                        m[base + c] = 1
+                                    if c >= 97 and c <= 122:
+                                        m[base + c - 64] = 1
+                        m[post + pc * 2] = 1
+                        m[post + pc * 2 + 1] = base
+                        pc = pc + 1
+                        need = 0
+    if need:
+        m[post + pc * 2] = 7
+        pc = pc + 1
+    while oc > 0:
+        oc = oc - 1
+        m[post + pc * 2] = m[op + oc]
+        pc = pc + 1
+    fr = alloc(256)
+    ns = 0
+    fc = 0
+    k = 0
+    while k < pc:
+        t = m[post + k * 2]
+        arg = m[post + k * 2 + 1]
+        if t == 1 or t == 7:
+            s = ns
+            e = ns + 1
+            ns = ns + 2
+            m[st + s * 4] = t == 1
+            m[st + s * 4 + 1] = e
+            m[st + s * 4 + 2] = -1
+            m[st + s * 4 + 3] = arg
+            m[st + e * 4] = 0
+            m[st + e * 4 + 1] = -1
+            m[st + e * 4 + 2] = -1
+            m[fr + fc * 2] = s
+            m[fr + fc * 2 + 1] = e
+            fc = fc + 1
+        else:
+            fc = fc - 1
+            b = m[fr + fc * 2]
+            eb = m[fr + fc * 2 + 1]
+            if t == 2:
+                fc = fc - 1
+                a = m[fr + fc * 2]
+                ea = m[fr + fc * 2 + 1]
+                m[st + ea * 4 + 1] = b
+                m[fr + fc * 2] = a
+                m[fr + fc * 2 + 1] = eb
+                fc = fc + 1
+            else:
+                s = ns
+                e = ns + 1
+                ns = ns + 2
+                m[st + s * 4] = 0
+                m[st + s * 4 + 1] = b
+                m[st + s * 4 + 2] = e
+                m[st + e * 4] = 0
+                m[st + e * 4 + 1] = -1
+                m[st + e * 4 + 2] = -1
+                if t == 3:
+                    fc = fc - 1
+                    a = m[fr + fc * 2]
+                    ea = m[fr + fc * 2 + 1]
+                    m[st + s * 4 + 1] = a
+                    m[st + s * 4 + 2] = b
+                    m[st + ea * 4 + 1] = e
+                    m[st + eb * 4 + 1] = e
+                else:
+                    if t == 4:
+                        m[st + eb * 4 + 1] = s
+                    else:
+                        if t == 5:
+                            m[st + eb * 4 + 1] = s
+                            s = b
+                        else:
+                            m[st + eb * 4 + 1] = e
+                m[fr + fc * 2] = s
+                m[fr + fc * 2 + 1] = e
+                fc = fc + 1
+        k = k + 1
+    start = m[fr]
+    finish = m[fr + 1]
+    ra = pat + plen
+    nr = m[ra]
+    ra = ra + 1
+    r = 0
+    while r < nr:
+        length = m[ra]
+        data = ra + 1
+        i = 0
+        while i < ns:
+            m[cur + i] = 0
+            i = i + 1
+        m[cur + start] = 1
+        qn = 1
+        m[todo] = start
+        qi = 0
+        while qi < qn:
+            s = m[todo + qi]
+            qi = qi + 1
+            if m[st + s * 4] == 0:
+                d = m[st + s * 4 + 1]
+                if d >= 0 and not m[cur + d]:
+                    m[cur + d] = 1
+                    m[todo + qn] = d
+                    qn = qn + 1
+                d = m[st + s * 4 + 2]
+                if d >= 0 and not m[cur + d]:
+                    m[cur + d] = 1
+                    m[todo + qn] = d
+                    qn = qn + 1
+        j = 0
+        while j < length:
+            c = m[data + j]
+            oldqn = qn
+            i = 0
+            # `todo` is the current epsilon closure, so no full-state scan is
+            # needed for each input byte.
+            while i < qn:
+                s = m[todo + i]
+                if m[st + s * 4]:
+                    base = m[st + s * 4 + 3]
+                    if m[base + c - 32]:
+                        d = m[st + s * 4 + 1]
+                        if not m[nxt + d]:
+                            m[nxt + d] = 1
+                i = i + 1
+            qn = 0
+            i = 0
+            while i < ns:
+                if m[nxt + i]:
+                    m[active + qn] = i
+                    qn = qn + 1
+                i = i + 1
+            qi = 0
+            while qi < qn:
+                s = m[active + qi]
+                qi = qi + 1
+                if m[st + s * 4] == 0:
+                    d = m[st + s * 4 + 1]
+                    if d >= 0 and not m[nxt + d]:
+                        m[nxt + d] = 1
+                        m[active + qn] = d
+                        qn = qn + 1
+                    d = m[st + s * 4 + 2]
+                    if d >= 0 and not m[nxt + d]:
+                        m[nxt + d] = 1
+                        m[active + qn] = d
+                        qn = qn + 1
+            i = 0
+            while i < oldqn:
+                # Clear the old closure as it is no longer needed; the new
+                # closure becomes current by swapping the region bases.
+                m[cur + m[todo + i]] = 0
+                i = i + 1
+            hold = cur
+            cur = nxt
+            nxt = hold
+            hold = todo
+            todo = active
+            active = hold
+            j = j + 1
+        if m[cur + finish]:
+            oi = m[out]
+            m[out + oi + 1] = r
+            m[out] = oi + 1
+        ra = data + length
+        r = r + 1
+    return out
