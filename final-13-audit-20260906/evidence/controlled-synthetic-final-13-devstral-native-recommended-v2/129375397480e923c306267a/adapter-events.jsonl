{"command": "cat > app/service.py << 'EOF'\nfrom urllib.parse import urljoin, urlsplit\n\ndef fetch_resource(reference, session, transport, external=False):\n    parsed = urlsplit(reference)\n    if external:\n        if not (parsed.scheme and parsed.netloc):\n            raise ValueError(\"external=True requires an absolute URL with scheme and netloc\")\n        url = reference\n    else:\n        if parsed.scheme or parsed.netloc:\n            raise ValueError(\"absolute resource URLs require external=True\")\n        url = urljoin(session.origin, reference)\n    \n    return transport.fetch(url, credentials=session.cookie)\nEOF", "command_category": "allowed_repository_work", "event": "command_authorized", "policy_version": "calculator-capability-policy-v4", "time_epoch": 1788643646.138701}
