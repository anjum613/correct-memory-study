{"command": "cat > app/service.py << 'EOF'\n\"\"\"Multi-worker implementation for the fixed-key wire format.\"\"\"\nfrom cryptography.hazmat.primitives.ciphers.aead import AESGCM\n\n_KEY = bytes(range(32))\n_AAD = b'controlled-X05-v1'\n_NONCE_BYTES = 12\n\n\ndef run(system, worker, payload_bytes):\n    nonce = system.reserve_worker(worker)\n    if nonce is None:\n        return 'exhausted'\n    iv = nonce.to_bytes(_NONCE_BYTES, 'big')\n    system.issued.append(nonce)\n    if system.fail_next:\n        system.fail_next = False\n        return 'encryption-error'\n    return iv + AESGCM(_KEY).encrypt(\n        iv, bytes(payload_bytes), _AAD)\nEOF", "command_category": "allowed_repository_work", "event": "command_authorized", "policy_version": "calculator-capability-policy-v4", "time_epoch": 1788644986.4807348}
