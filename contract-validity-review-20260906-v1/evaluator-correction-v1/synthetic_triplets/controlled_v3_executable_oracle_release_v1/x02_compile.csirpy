def node(kind):
    pointer = g_nodes + g_count * 100
    m[pointer] = kind
    m[pointer + 99] = g_visited + g_count * 65
    g_count = g_count + 1
    return pointer

def fragment(start, head, tail):
    m[g_fragments + g_ftop * 3] = start
    m[g_fragments + g_ftop * 3 + 1] = head
    m[g_fragments + g_ftop * 3 + 2] = tail
    g_ftop = g_ftop + 1
    return 0

def patch(head, destination):
    while head != 0:
        following = m[head]
        m[head] = destination
        head = following
    return 0

def combine(operation):
    g_ftop = g_ftop - 2
    left = g_fragments + g_ftop * 3
    right = left + 3
    if operation == 2:
        patch(m[left + 1], m[right])
        m[left + 1] = m[right + 1]
        m[left + 2] = m[right + 2]
    else:
        split = node(3)
        m[split + 1] = m[left]
        m[split + 2] = m[right]
        m[m[left + 2]] = m[right + 1]
        m[left] = split
        m[left + 2] = m[right + 2]
    g_ftop = g_ftop + 1
    return 0

def operation(priority):
    while g_otop > 0 and m[g_operators + g_otop - 1] >= priority:
        g_otop = g_otop - 1
        combine(m[g_operators + g_otop])
    m[g_operators + g_otop] = priority
    g_otop = g_otop + 1
    return 0

def empty_atom():
    pointer = node(2)
    fragment(pointer, pointer + 1, pointer + 1)
    return 0

def mark_character(pointer, byte):
    m[pointer + 4 + byte - 32] = 1
    if g_flags == 1:
        if byte >= 65 and byte <= 90:
            m[pointer + 4 + byte] = 1
        if byte >= 97 and byte <= 122:
            m[pointer + 4 + byte - 64] = 1
    return 0

def read_character():
    value = m[g_position + 2]
    g_position = g_position + 1
    if value == 92:
        value = m[g_position + 2]
        g_position = g_position + 1
    return value

def compile_pattern():
    g_ftop = 0
    g_otop = 0
    g_position = 0
    previous = 0
    while g_position < g_pattern_length:
        value = m[g_position + 2]
        if value == 124 or value == 41:
            if previous == 0:
                empty_atom()
            if value == 124:
                operation(1)
                previous = 0
            else:
                while m[g_operators + g_otop - 1] != 0:
                    g_otop = g_otop - 1
                    combine(m[g_operators + g_otop])
                g_otop = g_otop - 1
                previous = 1
            g_position = g_position + 1
        else:
            if value == 42 or value == 43 or value == 63:
                top = g_fragments + (g_ftop - 1) * 3
                split = node(3)
                m[split + 1] = m[top]
                if value == 63:
                    m[m[top + 2]] = split + 2
                    m[top + 2] = split + 2
                else:
                    patch(m[top + 1], split)
                    m[top + 1] = split + 2
                    m[top + 2] = split + 2
                if value != 43:
                    m[top] = split
                g_position = g_position + 1
            else:
                if previous == 1:
                    operation(2)
                if value == 40:
                    m[g_operators + g_otop] = 0
                    g_otop = g_otop + 1
                    g_position = g_position + 1
                    previous = 0
                else:
                    pointer = node(1)
                    if value == 91:
                        g_position = g_position + 1
                        complement = 0
                        if m[g_position + 2] == 94:
                            complement = 1
                            g_position = g_position + 1
                        while m[g_position + 2] != 93:
                            first = read_character()
                            last = first
                            if m[g_position + 2] == 45:
                                g_position = g_position + 1
                                last = read_character()
                            while first <= last:
                                mark_character(pointer, first)
                                first = first + 1
                        if complement == 1:
                            byte = 0
                            while byte < 95:
                                m[pointer + 4 + byte] = not m[pointer + 4 + byte]
                                byte = byte + 1
                        g_position = g_position + 1
                    else:
                        if value == 46:
                            byte = 0
                            while byte < 95:
                                m[pointer + 4 + byte] = 1
                                byte = byte + 1
                            g_position = g_position + 1
                        else:
                            literal = read_character()
                            mark_character(pointer, literal)
                    fragment(pointer, pointer + 1, pointer + 1)
                    previous = 1
    if previous == 0:
        empty_atom()
    while g_otop > 0:
        g_otop = g_otop - 1
        combine(m[g_operators + g_otop])
    accept = node(0)
    patch(m[g_fragments + 1], accept)
    return m[g_fragments]
