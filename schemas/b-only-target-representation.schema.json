{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmpilot-b-only-target-representation-v1",
  "title": "Oracle-free target representation derived from public B and task text",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_instance_id",
    "benchmark_revision",
    "b_snapshot_sha256",
    "task_statement",
    "language",
    "repository_visible_imports",
    "repository_visible_libraries",
    "repository_visible_api_calls",
    "task_described_operation",
    "visible_target_symbols",
    "types_and_data_roles",
    "ast_structure",
    "operation_categories",
    "task_semantic_embedding",
    "configuration_context"
  ],
  "properties": {
    "benchmark_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_revision": {
      "const": "7e1b4b05240e56dc2b4e8253b2cc5c9481d016f3"
    },
    "b_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_statement": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "python"
    },
    "repository_visible_imports": {
      "$ref": "#/$defs/stringArray"
    },
    "repository_visible_libraries": {
      "$ref": "#/$defs/stringArray"
    },
    "repository_visible_api_calls": {
      "$ref": "#/$defs/stringArray"
    },
    "task_described_operation": {
      "type": "string",
      "minLength": 1
    },
    "visible_target_symbols": {
      "$ref": "#/$defs/stringArray"
    },
    "types_and_data_roles": {
      "$ref": "#/$defs/stringArray"
    },
    "ast_structure": {
      "$ref": "#/$defs/stringArray"
    },
    "operation_categories": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "task_semantic_embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_revision", "vector"],
      "properties": {
        "model": {
          "const": "deterministic-local-hash-vectorizer"
        },
        "model_revision": {
          "const": "cmpilot-hash-vectorizer-64-v1"
        },
        "vector": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "configuration_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b_code_available",
        "b_code_file_count",
        "b_code_files",
        "b_code_sha256",
        "feature_extractor",
        "normalized_task_tokens_sha256"
      ],
      "properties": {
        "b_code_available": {"type": "boolean"},
        "b_code_file_count": {"type": "integer", "minimum": 0, "maximum": 8},
        "b_code_files": {"type": "string"},
        "b_code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "feature_extractor": {"const": "cmpilot-context-dependent-memory-source-pairing-v1"},
        "normalized_task_tokens_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "forbidden_information": [
    "U",
    "R",
    "future history",
    "vulnerability type or identifier",
    "security test or PoV",
    "safe repair or target fix",
    "focal evaluator outcome"
  ]
}
