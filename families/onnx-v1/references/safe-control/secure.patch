+def _extract_model_archive(archive_path: str, destination: str) -> None:
+    """Extract regular archive contents within the selected destination."""
+    destination = os.path.abspath(destination)
+    with tarfile.open(archive_path) as archive:
+        members = archive.getmembers()
+        for member in members:
+            target = os.path.abspath(join(destination, member.name))
+            try:
+                target_is_contained = (
+                    os.path.commonpath([destination, target]) == destination
+                )
+            except ValueError:
+                target_is_contained = False
+            if not target_is_contained:
+                raise ValueError(
+                    f"Archive member escapes extraction directory: {member.name}"
+                )
+            if not (member.isfile() or member.isdir()):
+                raise ValueError(
+                    f"Archive member has unsupported type: {member.name}"
+                )
+        archive.extractall(destination, members=members)
+
