d":"","url":"https://api.github.com/users/justinchuby","html_url":"https://github.com/justinchuby","followers_url":"https://api.github.com/users/justinchuby/followers","following_url":"https://api.github.com/users/justinchuby/following{/other_user}","gists_url":"https://api.github.com/users/justinchuby/gists{/gist_id}","starred_url":"https://api.github.com/users/justinchuby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinchuby/subscriptions","organizations_url":"https://api.github.com/users/justinchuby/orgs","repos_url":"https://api.github.com/users/justinchuby/repos","events_url":"https://api.github.com/users/justinchuby/events{/privacy}","received_events_url":"https://api.github.com/users/justinchuby/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":7,"created_at":"2024-05-23T02:25:21Z","updated_at":"2024-06-06T22:21:18Z","closed_at":"2024-06-06T22:21:18Z","assignee":{"login":"justinchuby","id":11205048,"node_id":"MDQ6VXNlcjExMjA1MDQ4","avatar_url":"https://avatars.githubusercontent.com/u/11205048?v=4","gravatar_id":"","url":"https://api.github.com/users/justinchuby","html_url":"https://github.com/justinchuby","followers_url":"https://api.github.com/users/justinchuby/followers","following_url":"https://api.github.com/users/justinchuby/following{/other_user}","gists_url":"https://api.github.com/users/justinchuby/gists{/gist_id}","starred_url":"https://api.github.com/users/justinchuby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinchuby/subscriptions","organizations_url":"https://api.github.com/users/justinchuby/orgs","repos_url":"https://api.github.com/users/justinchuby/repos","events_url":"https://api.github.com/users/justinchuby/events{/privacy}","received_events_url":"https://api.github.com/users/justinchuby/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/onnx/onnx/pulls/6145","html_url":"https://github.com/onnx/onnx/pull/6145","diff_url":"https://github.com/onnx/onnx/pull/6145.diff","patch_url":"https://github.com/onnx/onnx/pull/6145.patch","merged_at":null},"body":"\r\n### Description\r\n<!-- - Describe your changes. -->\r\nHello there, I submitted a change to `test_download_model_with_test_data`  function in hub module to prevent potential path traversal attacks when user trying to download test data from a malicious repo.\r\n\r\n### Motivation and Context\r\n<!-- - Why is this change required? What problem does it solve? -->\r\n<!-- - If it fixes an open issue, please link to the issue here. -->\r\nIn [https://github.com/onnx/onnx/blob/4128a09009aa67622c6308c82fe4199813a71682/onnx/hub.py#L369](https://github.com/onnx/onnx/blob/4128a09009aa67622c6308c82fe4199813a71682/onnx/hub.py#L369)\r\nA tarball in third party repo can be downloaded and extracted without sanitized which may cause arbitrary file overwrite.\r\nThis patch will detect files which contain path traversal sequences and symbolic links in Tarball before extracting to file system and throw an exception to prevent path traversal attacks and symlink attacks.\r\n\r\n### Reference\r\n\r\n[https://huntr.com/bounties/5d7e5752-085c-4e93-af0d-e25f05a27b89](https://huntr.com/bounties/5d7e5752-085c-4e93-af0d-e25f05a27b89)","closed_by":{"login":"justinchuby","id":11205048,"node_id":"MDQ6VXNlcjExMjA1MDQ4","avatar_url":"https://avatars.githubusercontent.com/u/11205048?v=4","gravatar_id":"","url":"https://api.github.com/users/justinchuby","html_url":"https://github.com/justinchuby","followers_url":"https://api.github.com/users/justinchuby/followers","following_url":"https://api.github.com/users/justinchuby/following{/other_user}","gists_url":"https://api.github.com/users/justinchuby/gists{/gist_id}","starred_url":"https://api.github.com/users/justinchuby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinchuby/subscriptions","organizations_url":"https://api.github.com/users/justinchuby/orgs","repos_url":"https://api.github.com/users/justinchuby/repos","events_url":"https://api.github.com/users/justinchuby/events{/privacy}","received_events_url":"https://api.github.com/users/justinchuby/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/onnx/onnx/issues/6145/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/onnx/onnx/issues/6145/timeline","performed_via_github_app":null,"state_reason":null}