+def _forbidden_keys(value: Any) -> set[str]:
+    found: set[str] = set()
+    if isinstance(value, Mapping):
+        for key, nested in value.items():
+            if str(key) in FORBIDDEN_DISCOVERY_ASSIGNMENTS:
+                found.add(str(key))
+            found.update(_forbidden_keys(nested))
+    elif isinstance(value, list):
+        for nested in value:
+            found.update(_forbidden_keys(nested))
+    return found
